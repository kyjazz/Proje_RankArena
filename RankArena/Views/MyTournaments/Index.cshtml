@model List<RankArena.Models.Entities.Tournament>

<style>
    .my-tournaments-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        background: rgba(16, 19, 30, 0.75);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 14px;
        overflow: hidden;
    }

        .my-tournaments-table thead th {
            background: rgba(20, 23, 35, 0.95);
            color: #ffb020;
            font-weight: 700;
            font-size: 0.85rem;
            padding: 14px 16px;
            border-bottom: 2px solid rgba(255,176,32,0.2);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .my-tournaments-table tbody tr {
            transition: background 0.15s ease;
        }

            .my-tournaments-table tbody tr:hover {
                background: rgba(255,255,255,0.04);
            }

        .my-tournaments-table td {
            padding: 14px 16px;
            color: #e9ecff;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            vertical-align: middle;
            font-size: 0.92rem;
        }

    .tournament-title {
        color: #ffffff;
        font-weight: 700;
        font-size: 1rem;
    }

    .tournament-slug {
        color: rgba(233,236,255,0.5);
        font-size: 0.82rem;
    }
</style>

<h2 style="color:#e9ecff; font-weight:800;">Benim Turnuvalarım</h2>

<a class="btn btn-success mb-3" asp-action="Create">
    + Turnuva Oluştur
</a>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Henüz oluşturduğun bir turnuva yok.
    </div>
}
else
{
    <table class="my-tournaments-table">
        <thead>
            <tr>
                <th>Başlık</th>
                <th>Durum</th>
                <th>Slug</th>
                <th style="width:340px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td><span class="tournament-title">@t.Title</span></td>

                    <td>
                        @if (t.IsPublished)
                        {
                            <span class="badge bg-success">Yayınlı</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Onay Bekliyor</span>
                        }
                    </td>

                    <td>
                        <span class="tournament-slug">@t.Slug</span>
                    </td>

                    <td class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-controller="MyTournaments"
                           asp-action="Edit"
                           asp-route-id="@t.Id">
                            Düzenle
                        </a>

                        <a class="btn btn-sm btn-outline-secondary"
                           asp-controller="Tournaments"
                           asp-action="Details"
                           asp-route-slug="@t.Slug">
                            Önizleme
                        </a>

                        <button type="button" class="btn btn-sm btn-outline-danger"
                                onclick="showDeleteModal(@t.Id, '@t.Title.Replace("'", "\\'")')">
                            🗑️ Sil
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- SİLME ONAY MODALI -->
<div id="deleteModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.6); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:#0f1428; border:1px solid rgba(255,100,100,0.3); border-radius:16px; padding:28px; max-width:420px; width:90%; text-align:center;">
        <h5 style="color:#e9ecff; font-weight:800; margin-bottom:10px;">🗑️ Turnuvayı Sil</h5>
        <p style="color:rgba(233,236,255,0.7); font-size:0.9rem; margin-bottom:20px;">
            <strong id="deleteTournamentName" style="color:#ff4444;"></strong> turnuvasını silmek istediğinize emin misiniz?
            <br /><small style="color:rgba(233,236,255,0.5);">Bu işlem geri alınamaz. Tüm item'lar, oynanma verileri, yorumlar ve puanlar kalıcı olarak silinecektir.</small>
        </p>
        <div style="display:flex; gap:12px; justify-content:center;">
            <form id="deleteForm" method="post" asp-controller="MyTournaments" asp-action="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />
                <button type="submit" style="background:#ff4444; color:#fff; font-weight:700; border:none; padding:10px 28px; border-radius:10px; font-size:0.9rem; cursor:pointer;">
                    Evet, Sil
                </button>
            </form>
            <button type="button" onclick="hideDeleteModal()"
                    style="background:none; border:1px solid rgba(255,255,255,0.2); color:rgba(233,236,255,0.7); font-weight:600; padding:10px 28px; border-radius:10px; font-size:0.9rem; cursor:pointer;">
                İptal
            </button>
        </div>
    </div>
</div>

<script>
    function showDeleteModal(id, title) {
        document.getElementById('deleteId').value = id;
        document.getElementById('deleteTournamentName').textContent = title;
        document.getElementById('deleteModal').style.display = 'flex';
    }
    function hideDeleteModal() {
        document.getElementById('deleteModal').style.display = 'none';
    }
    // Modal dışına tıklanınca kapat
    document.getElementById('deleteModal').addEventListener('click', function (e) {
        if (e.target === this) hideDeleteModal();
    });
</script>