@model List<RankArena.Models.Entities.Tournament>

<h2>Benim Turnuvalarım</h2>

<a class="btn btn-success mb-3" asp-action="Create">
    + Turnuva Oluştur
</a>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Henüz oluşturduğun bir turnuva yok.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Başlık</th>
                <th>Durum</th>
                <th>Slug</th>
                <th style="width:260px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Title</td>

                    <td>
                        @if (t.IsPublished)
                        {
                            <span class="badge bg-success">Yayınlı</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Onay Bekliyor</span>
                        }
                    </td>

                    <td>
                        <small class="text-muted">@t.Slug</small>
                    </td>

                    <td class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-controller="MyTournaments"
                           asp-action="Edit"
                           asp-route-id="@t.Id">
                            Düzenle
                        </a>

                        <a class="btn btn-sm btn-outline-secondary"
                           asp-controller="Tournaments"
                           asp-action="Details"
                           asp-route-slug="@t.Slug">
                            Önizleme
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}