﻿@using RankArena.Models.Entities
@{
}

<h2>Turnuva Oluştur</h2>

<form method="post">
    @Html.AntiForgeryToken()

    <div class="mb-2">
        <label class="form-label">Başlık</label>
        <input class="form-control" name="title" />
    </div>

    <div class="mb-2">
        <label class="form-label">Açıklama</label>
        <textarea class="form-control" name="description"></textarea>
    </div>

    <div class="mb-2">
        <label class="form-label">Kapak Görsel URL (opsiyon)</label>
        <input class="form-control" name="coverImageUrl" />
    </div>

    <div class="mb-2">
        <label class="form-label">Kategori</label>
        <select class="form-control" name="categoryId">
            <option value="">-- Kategori Seçin (opsiyonel) --</option>
            @if (ViewBag.Categories != null)
            {
                foreach (Category c in ViewBag.Categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            }
        </select>
    </div>

    <button class="btn btn-primary" type="submit">Kaydet (Onay Bekler)</button>
</form>