</style>

@* ========== ARKA PLAN ========== *@
<div class="blind-bg">
    <div class="blind-bg-img" style="background-image: url('@(currentThumb ?? "")');"></div>
    <div class="blind-bg-overlay"></div>
</div>

<div class="scene">

    @* ========== TOP BAR ========== *@
    <div class="q-topbar">
        <div class="q-left">
            <a class="q-exit"
               href="@(string.IsNullOrWhiteSpace(slug) ? Url.Action("Index","Home") : $"/t/{slug}")">
                ← ÇIKIŞ
            </a>
            <span class="q-title">🕶️ Blind Rank</span>
        </div>
        <div class="q-pills">
            <span class="q-pill">RunId: @Model.RunId</span>
            <span class="q-pill">✅ @done / @total</span>
            <span class="q-pill">❌ Kalan: @remaining</span>
            <span class="q-pill">📈 %@percent</span>
        </div>
    </div>

    @* ========== PROGRESS ========== *@
    <div class="q-progress">
        <div class="q-progress-fill" style="width:@percent%"></div>
    </div>

    @* ========== MAIN ========== *@
    <div class="q-main">

        @* ========== SOL: SLOTLAR ========== *@
        <div class="q-sidebar">
            <div class="q-sidebar-title">📋 Sıralama</div>
            <div class="q-sidebar-scroll">
                @foreach (var s in slots)
                {
                    var isFilled = s.TournamentItemId != null;
                    var si = s.TournamentItem;
                    var thumb = !string.IsNullOrWhiteSpace(si?.ImageUrl) ? si!.ImageUrl : YtThumb(si?.YouTubeVideoId);
                    var topClass = (isFilled && s.Position == 1) ? "top1"
                    : (isFilled && s.Position == 2) ? "top2"
                    : (isFilled && s.Position == 3) ? "top3" : "";

                    <form asp-action="BlindPlace" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="runId" value="@Model.RunId" />
                        <input type="hidden" name="blindRunItemId" value="@Model.Id" />
                        <input type="hidden" name="position" value="@s.Position" />

                        <button type="submit"
                                class="q-slot @(isFilled ? "filled" : "") @topClass"
                        @(isFilled ? "disabled" : "")>

                            <div class="q-slot-num">@s.Position</div>
                            <div class="q-slot-thumb">
                                @if (isFilled && !string.IsNullOrWhiteSpace(thumb))
                                {
                                    <img src="@thumb" alt="" />
                                }
                                else if (isFilled)
                                {
                                    <span>✓</span>
                                }
                                else
                                {
                                    <span>?</span>
                                }
                            </div>
                            <div class="q-slot-info">
                                <p class="q-slot-name">@(isFilled ? (si?.Name ?? "Seçildi") : "Boş Slot")</p>
                                <p class="q-slot-meta">@(isFilled ? "Kilitledin" : "Tıkla → Yerleştir")</p>
                            </div>
                        </button>
                    </form>
                }
            </div>
        </div>

        @* ========== SAĞ: İÇERİK ========== *@
        <div class="q-content">

            @* ========== HERO (Quizei tarzı: arkada kapak + ortada küçük video) ========== *@
            <div class="q-hero-outer" id="heroOuter">

                @* Shuffle overlay *@
                <div class="shuffle-overlay" id="shuffleOverlay">
                    @foreach (var th in allThumbs)
                    {
                        <img class="shuffle-img" src="@th" alt="" />
                    }
                    <div class="shuffle-label">🎲 Seçiliyor...</div>
                </div>

                @if (showVideo)
                {
                    @* Arkadaki kapak görseli (büyük, hafif blur) *@
                    <div class="q-hero-backdrop" style="background-image: url('@YtThumb(item!.YouTubeVideoId)');"></div>

                    <div class="q-hero-inner">
                        @* Video başlık satırı *@
                        <div class="q-video-header">
                            <div class="q-video-channel-icon">🎵</div>
                            <div class="q-video-title-text">@item.Name</div>
                            <div class="q-video-actions">
                                <a class="q-video-action"
                                   href="@(string.IsNullOrWhiteSpace(slug) ? Url.Action("Index","Home") : $"/t/{slug}")">
                                    <span class="q-video-action-icon">🕐</span>
                                    Daha sonr...
                                </a>
                                <button class="q-video-action" onclick="sharePage()">
                                    <span class="q-video-action-icon">↗</span>
                                    Paylaş
                                </button>
                            </div>
                        </div>

                        @* Video frame (küçük, Quizei gibi) *@
                        <div class="q-video-frame" id="videoFrame">
                            <img class="q-thumb-play"
                                 src="@YtThumb(item.YouTubeVideoId)"
                                 alt="@item.Name" />
                            <div class="q-play-overlay" onclick="playMainVideo('@item.YouTubeVideoId')">
                                <div class="q-play-btn"></div>
                            </div>
                            <iframe id="mainIframe" allowfullscreen allow="autoplay"></iframe>
                        </div>

                        @* YouTube badge *@
                        <div class="q-yt-badge">
                            <span>İzlemek için:</span>
                            <span class="q-yt-icon"></span>
                            <span>YouTube</span>
                        </div>
                    </div>
                }
                else if (showImage)
                {
                    <img src="@item!.ImageUrl" class="q-hero-img-full" />
                }
                else
                {
                    <div class="q-hero-empty">Görsel / Video yok</div>
                }
            </div>

            @* ========== İTEM İSMİ (Quizei sarı kutu) ========== *@
            <div class="q-name-box">
                @item?.Name
            </div>

            @* ========== ALT SATIR ========== *@
            <div class="q-bottom-row">
                <div class="q-hint-text">
                    İpucu: Blind mantığı gereği, item'ları "bilmeden" doğru sıraya koyuyorsun.
                </div>
                <div class="q-bottom-actions">
                    <button class="q-btn-more" onclick="document.getElementById('morePopup').classList.add('show')">
                        📺 Daha fazla video
                    </button>
                    <a class="q-btn-small"
                       href="@(string.IsNullOrWhiteSpace(slug) ? Url.Action("Index","Home") : $"/t/{slug}")">
                        <span class="q-btn-icon">🕐</span>
                        Daha Sonr...
                    </a>
                    <button class="q-btn-small" onclick="sharePage()">
                        <span class="q-btn-icon">↗</span>
                        Paylaş
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ========== FOOTER ========== *@
    <div class="q-footer">
        <div class="q-footer-text">made with <strong>RankArena</strong></div>
    </div>
</div>

@* ========== DAHA FAZLA VİDEO POPUP ========== *@
<div class="q-popup-overlay" id="morePopup">
    <div class="q-popup">
        <div class="q-popup-head">
            <span class="q-popup-title">📺 Daha fazla video</span>
            <button class="q-popup-x" onclick="document.getElementById('morePopup').classList.remove('show')">✕</button>
        </div>
        <div class="q-popup-grid">
            @foreach (var s in slots)
            {
                var si = s.TournamentItem;
                if (si == null) continue;
                var popThumb = !string.IsNullOrWhiteSpace(si.ImageUrl) ? si.ImageUrl : YtThumb(si.YouTubeVideoId);
                if (string.IsNullOrWhiteSpace(popThumb)) continue;

                <div class="q-popup-card">
                    <img src="@popThumb" alt="@si.Name" />
                    <div class="q-popup-card-name">@si.Name</div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    // ========== VIDEO OYNAT ==========
    function playMainVideo(videoId) {
        var frame = document.getElementById('videoFrame');
        var iframe = document.getElementById('mainIframe');
        if (!frame || !iframe) return;
        iframe.src = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0';
        frame.classList.add('playing');
    }

    // ========== SHUFFLE ANİMASYONU ==========
    (function () {
        var overlay = document.getElementById('shuffleOverlay');
        if (!overlay) return;

        var imgs = overlay.querySelectorAll('.shuffle-img');
        if (imgs.length === 0) { overlay.style.display = 'none'; return; }

        var idx = 0;
        var totalCycles = Math.min(imgs.length * 3, 18);
        var interval = 90;
        var count = 0;

        imgs[0].classList.add('active');

        var timer = setInterval(function () {
            imgs[idx].classList.remove('active');
            idx = (idx + 1) % imgs.length;
            imgs[idx].classList.add('active');
            count++;

            if (count > totalCycles - 6) interval += 35;
            if (count > totalCycles - 3) interval += 70;

            if (count >= totalCycles) {
                clearInterval(timer);
                setTimeout(function () {
                    overlay.classList.add('hide');
                    setTimeout(function () { overlay.style.display = 'none'; }, 450);
                }, 300);
            }
        }, interval);
    })();

    // ========== PAYLAŞ ==========
    function sharePage() {
        var url = window.location.href;
        if (navigator.share) {
            navigator.share({ title: 'RankArena - Blind Rank', url: url });
        } else if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(function () { alert('Link kopyalandı!'); });
        } else {
            prompt('Linki kopyala:', url);
        }
    }
</script>