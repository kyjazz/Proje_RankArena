@model RankArena.Models.Entities.BlindRunItem
@using RankArena.Models.Entities

@{
    ViewData["Title"] = "Blind Rank";

    var item = Model.TournamentItem;

    var slots = ViewBag.Slots as List<BlindSlot> ?? new List<BlindSlot>();
    int total = ViewBag.TotalSlots ?? slots.Count;
    int done = ViewBag.Completed ?? 0;
    int remaining = ViewBag.Remaining ?? (total - done);
    int percent = ViewBag.Percent ?? 0;

    bool hasImage = !string.IsNullOrWhiteSpace(item?.ImageUrl);
    bool hasVideo = !string.IsNullOrWhiteSpace(item?.YouTubeVideoId);
    bool showImage = hasImage;
    bool showVideo = !hasImage && hasVideo;

    var slug = ViewBag.Slug as string;

    string? YtThumb(string? videoId)
        => string.IsNullOrWhiteSpace(videoId) ? null : $"https://img.youtube.com/vi/{videoId}/hqdefault.jpg";

    // Mevcut item'ın kapak görseli
    var currentThumb = !string.IsNullOrWhiteSpace(item?.ImageUrl)
        ? item!.ImageUrl
        : YtThumb(item?.YouTubeVideoId);

    // Shuffle için tüm thumbnail'ler
    var allThumbs = new List<string>();
    foreach (var s in slots)
    {
        var si = s.TournamentItem;
        var t = !string.IsNullOrWhiteSpace(si?.ImageUrl) ? si!.ImageUrl : YtThumb(si?.YouTubeVideoId);
        if (!string.IsNullOrWhiteSpace(t) && !allThumbs.Contains(t!)) { allThumbs.Add(t!); }
    }
    if (!string.IsNullOrWhiteSpace(currentThumb) && !allThumbs.Contains(currentThumb!))
    {
        allThumbs.Add(currentThumb!);
    }
}

<style>
    html, body {
        height: 100%;
        margin: 0 !important;
        padding: 0 !important;
    }

    body {
        background: #1a1f3a !important;
        overflow-x: hidden;
    }

    header, nav, .navbar, footer {
        display: none !important;
    }

    /* ========== QUIZEI ARKA PLAN ========== */
    .blind-bg {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
    }

    .blind-bg-img {
        position: absolute;
        inset: -60px;
        background-size: cover;
        background-position: center;
        filter: blur(18px) brightness(0.45) saturate(1.5);
        transform: scale(1.25);
        transition: background-image 0.5s ease;
    }

    .blind-bg-overlay {
        position: absolute;
        inset: 0;
        background: rgba(20, 24, 50, 0.55);
    }

    /* ========== SCENE ========== */
    .scene {
        position: relative;
        z-index: 2;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        color: #e9ecff;
        font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    }

    /* ========== TOP BAR (Quizei tarzı ince bar) ========== */
