@model RankArena.Models.Entities.BracketMatch
@{
    Layout = null;

    var left = Model.LeftItem;
    var right = Model.RightItem;

    int? totalThisRound = ViewBag.TotalThisRound as int?;
    int? remainingThisRound = ViewBag.RemainingThisRound as int?;

    var roundName = ViewBag.RoundName as string;

    int totalMatches = ViewBag.TotalMatches ?? 0;
    int completedMatches = ViewBag.CompletedMatches ?? 0;
    int remainingMatches = ViewBag.RemainingMatches ?? 0;
    int progressPercent = ViewBag.ProgressPercent ?? 0;

    int totalSlots = ViewBag.TotalSlots ?? 0;
    string roundLabel = string.IsNullOrWhiteSpace(roundName) ? $"Round {Model.Round}" : roundName;
}

@functions {
    private static bool HasImage(RankArena.Models.Entities.TournamentItem? i)
        => !string.IsNullOrWhiteSpace(i?.ImageUrl);

    private static bool HasVideo(RankArena.Models.Entities.TournamentItem? i)
        => !string.IsNullOrWhiteSpace(i?.YouTubeVideoId);

    private static string? GetThumbnail(RankArena.Models.Entities.TournamentItem? i)
    {
        if (i == null) return null;
        if (!string.IsNullOrWhiteSpace(i.ImageUrl)) return i.ImageUrl;
        if (!string.IsNullOrWhiteSpace(i.YouTubeVideoId))
            return $"https://img.youtube.com/vi/{i.YouTubeVideoId}/hqdefault.jpg";
        return null;
    }
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@roundLabel • Match @Model.MatchNumber - RankArena</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            margin: 0; padding: 0;
            width: 100%; height: 100%;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #0a0e1a;
            color: #e9ecff;
        }

        /* ========== ARKA PLAN: İKİYE BÖLÜNMÜŞ BULANIK KAPAK ========== */
        .bg-blur {
            position: fixed;
            inset: 0;
            z-index: 0;
            display: flex;
        }
        .bg-blur-half {
            flex: 1;
            background-size: cover;
            background-position: center;
            filter: blur(32px) brightness(0.30) saturate(1.4);
            transform: scale(1.2);
        }
        .bg-divider {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 2px;
            z-index: 1;
            background: linear-gradient(to bottom,
                transparent 0%,
                rgba(255,176,32,0.15) 15%,
                rgba(255,176,32,0.25) 50%,
                rgba(255,176,32,0.15) 85%,
                transparent 100%);
            pointer-events: none;
        }
        .bg-overlay {
            position: fixed;
            inset: 0;
            z-index: 1;
            background: radial-gradient(ellipse at 50% 0%, rgba(10,14,26,0.2), rgba(10,14,26,0.75) 70%);
            pointer-events: none;
        }

        /* ========== ANA SAHNE ========== */
        .scene {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            height: 100vh;
            padding: 0;
        }

        /* ========== ÜST BAR ========== */
        .top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 24px;
            background: rgba(0,0,0,0.35);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.06);
            flex-shrink: 0;
        }
        .top-bar .exit-btn {
            color: rgba(233,236,255,0.7);
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: color .15s;
        }
        .top-bar .exit-btn:hover { color: #fff; }

        /* ========== BAŞLIK ========== */
        .header-area {
            text-align: center;
            padding: 16px 16px 8px;
            flex-shrink: 0;
        }

        /* ========== TUR BİLGİ PİLL ========== */
        .round-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 22px;
            border-radius: 999px;
            background: linear-gradient(135deg, #ff2d55, #ff6b2d);
            color: #fff;
            font-weight: 800;
            font-size: 15px;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 20px rgba(255,45,85,0.35);
            margin: 10px auto 6px;
            font-family: monospace;
        }

        /* ========== ARENA ALANI ========== */
        .arena {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0;
            padding: 12px 0;
            min-height: 0;
        }

        /* Her yarı kendi kartını ortalar */
        .arena-half {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 20px;
        }

        /* ========== KARTLAR ========== */
        .match-card {
            width: 100%;
            max-width: 520px;
            border-radius: 16px;
            overflow: hidden;
            position: relative;
            transition: transform 0.35s cubic-bezier(.22,.68,.31,1.2),
                        box-shadow 0.3s ease,
                        border-color 0.3s ease;
            border: 3px solid transparent;
            background: rgba(0,0,0,0.3);
            backdrop-filter: blur(6px);
        }
        .match-card.left-card {
            border-color: rgba(255,45,85,0.6);
            box-shadow: 0 0 30px rgba(255,45,85,0.15), inset 0 0 60px rgba(255,45,85,0.03);
        }
        .match-card.right-card {
            border-color: rgba(60,130,255,0.6);
            box-shadow: 0 0 30px rgba(60,130,255,0.15), inset 0 0 60px rgba(60,130,255,0.03);
        }

        .match-card:hover {
            transform: scale(1.04);
            z-index: 10;
        }
        .match-card.left-card:hover {
            border-color: rgba(255,45,85,0.9);
            box-shadow: 0 0 50px rgba(255,45,85,0.35), 0 20px 60px rgba(0,0,0,0.4);
        }
        .match-card.right-card:hover {
            border-color: rgba(60,130,255,0.9);
            box-shadow: 0 0 50px rgba(60,130,255,0.35), 0 20px 60px rgba(0,0,0,0.4);
        }

        /* Medya */
        .card-media {
            width: 100%;
            aspect-ratio: 16/10;
            position: relative;
            overflow: hidden;
            background: rgba(255,255,255,0.03);
        }
        .card-media img.thumb-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.4s ease;
        }
        .match-card:hover .card-media img.thumb-img {
            transform: scale(1.06);
        }
        .card-media .no-media {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(233,236,255,0.4);
            font-size: 14px;
            background: rgba(255,255,255,0.02);
        }

        /* Video thumbnail overlay + play butonu */
        .video-container {
            width: 100%;
            height: 100%;
            position: relative;
        }
        .video-container .video-thumb {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.4s ease;
        }
        .match-card:hover .video-thumb {
            transform: scale(1.06);
        }
        .video-container .play-btn {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            z-index: 3;
            width: 62px; height: 62px;
            background: rgba(255,0,0,0.88);
            border-radius: 50%;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 24px rgba(255,0,0,0.45);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .video-container .play-btn:hover {
            transform: translate(-50%, -50%) scale(1.15);
            box-shadow: 0 6px 32px rgba(255,0,0,0.6);
        }
        .play-btn::after {
            content: '';
            display: block;
            width: 0; height: 0;
            border-style: solid;
            border-width: 11px 0 11px 20px;
            border-color: transparent transparent transparent #fff;
            margin-left: 4px;
        }

        /* iframe video (gizli başlar, play'e basınca görünür) */
        .video-container iframe {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            border: none;
            z-index: 5;
            display: none;
        }
        .video-container.playing iframe {
            display: block;
        }
        .video-container.playing .video-thumb,
        .video-container.playing .play-btn {
            display: none;
        }

        /* Alt isim butonu - SEÇİM BURADAN YAPILIR */
        .card-label {
            padding: 14px 18px;
            text-align: center;
        }
        .card-label .select-btn {
            display: block;
            width: 100%;
            font-weight: 800;
            font-size: clamp(13px, 1.6vw, 18px);
            line-height: 1.3;
            padding: 12px 18px;
            border-radius: 10px;
            font-family: monospace;
            letter-spacing: 0.3px;
            border: none;
            cursor: pointer;
            transition: transform 0.15s ease, filter 0.15s ease, box-shadow 0.15s ease;
        }
        .card-label .select-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.1);
        }
        .left-card .select-btn {
            background: linear-gradient(90deg, #ff2d55, #ff5b3a);
            color: #fff;
            box-shadow: 0 4px 16px rgba(255,45,85,0.3);
        }
        .left-card .select-btn:hover {
            box-shadow: 0 6px 24px rgba(255,45,85,0.5);
        }
        .right-card .select-btn {
            background: linear-gradient(90deg, #2d7aff, #3c82ff);
            color: #fff;
            box-shadow: 0 4px 16px rgba(60,130,255,0.3);
        }
        .right-card .select-btn:hover {
            box-shadow: 0 6px 24px rgba(60,130,255,0.5);
        }

        /* ========== VS ALANI ========== */
        .vs-area {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 80px;
            flex-shrink: 0;
            z-index: 5;
        }
        .vs-icon {
            width: 72px; height: 72px;
            position: relative;
        }
        .vs-icon .bolt {
            font-size: 52px;
            filter: drop-shadow(0 0 12px rgba(255,215,0,0.6));
            animation: vs-pulse 1.8s ease-in-out infinite;
            display: block;
            text-align: center;
            line-height: 72px;
        }
        .vs-text {
            font-family: 'Press Start 2P', monospace;
            font-size: 18px;
            color: rgba(255,255,255,0.65);
            letter-spacing: 4px;
            margin-top: 4px;
            text-shadow: 0 0 10px rgba(255,255,255,0.2);
        }

        @@keyframes vs-pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.15); }
        }

        /* ========== ALT BİLGİ ========== */
        .bottom-info {
            text-align: center;
            padding: 8px 16px 14px;
            flex-shrink: 0;
        }
        .bottom-info .hint {
            color: rgba(233,236,255,0.45);
            font-size: 12px;
            font-style: italic;
        }
        .bottom-info .made-with {
            color: rgba(233,236,255,0.25);
            font-size: 11px;
            margin-top: 4px;
        }
        .bottom-info .made-with strong {
            color: rgba(255,176,32,0.6);
            font-weight: 800;
        }

        /* ========== SEÇİM ANİMASYONU ========== */
        .match-card.chosen {
            animation: cardChosen 0.6s ease forwards;
            z-index: 20;
        }
        .match-card.not-chosen {
            animation: cardDismiss 0.5s ease forwards;
            pointer-events: none;
        }

        @@keyframes cardChosen {
            0%   { transform: scale(1); }
            40%  { transform: scale(1.12); }
            100% { transform: scale(1.08); opacity: 1; }
        }
        @@keyframes cardDismiss {
            0%   { transform: scale(1); opacity: 1; }
            100% { transform: scale(0.85); opacity: 0.2; }
        }

        /* ========== FORM GİZLE ========== */
        .hidden-form { display: none; }

        /* ========== MOBİL ========== */
        @@media (max-width: 768px) {
            .arena {
                flex-direction: column;
                gap: 10px;
                padding: 8px 12px;
            }
            .arena-half {
                width: 100%;
                padding: 0;
            }
            .match-card {
                max-width: 100%;
                width: 100%;
            }
            .vs-area {
                width: auto;
                flex-direction: row;
                gap: 8px;
            }
            .vs-icon { width: 48px; height: 48px; }
            .vs-icon .bolt { font-size: 36px; line-height: 48px; }
            .vs-text { font-size: 14px; margin-top: 0; }
            .card-media { aspect-ratio: 16/9; }
            .bg-blur { flex-direction: column; }
            .bg-divider {
                top: 50%; left: 0; right: 0; bottom: auto;
                width: 100%; height: 2px;
                transform: translateY(-50%);
                background: linear-gradient(to right,
                    transparent 0%, rgba(255,176,32,0.15) 15%,
                    rgba(255,176,32,0.25) 50%, rgba(255,176,32,0.15) 85%,
                    transparent 100%);
            }
        }
    </style>
</head>
<body>

@{
    var leftThumb = GetThumbnail(left);
    var rightThumb = GetThumbnail(right);
    var bgLeft = leftThumb ?? "";
    var bgRight = rightThumb ?? "";

    var leftHasImage = HasImage(left);
    var leftHasVideo = HasVideo(left);
    var rightHasImage = HasImage(right);
    var rightHasVideo = HasVideo(right);

    // Sadece video varsa (resim yoksa) video modunda göster
    var leftShowVideo = !leftHasImage && leftHasVideo;
    var rightShowVideo = !rightHasImage && rightHasVideo;

    int matchesInRound = totalThisRound ?? 0;
    int completedInRound = matchesInRound - (remainingThisRound ?? 0);
    string quizeiPill = $"{roundLabel} • {completedInRound + 1}/{matchesInRound}";
}

<!-- Arka plan: İkiye bölünmüş bulanık kapak görselleri -->
<div class="bg-blur">
    <div class="bg-blur-half" style="background-image: url('@bgLeft');"></div>
    <div class="bg-blur-half" style="background-image: url('@bgRight');"></div>
</div>
<div class="bg-divider"></div>
<div class="bg-overlay"></div>

<div class="scene">

    <!-- Üst Bar -->
    <div class="top-bar">
        <a href="javascript:history.back()" class="exit-btn">← ÇIKIŞ</a>
        <div class="d-flex gap-2 flex-wrap justify-content-end" style="font-size:12px;">
            <span style="color:rgba(233,236,255,0.5);">RunId: @Model.RunId</span>
            @if (totalMatches > 0)
            {
                <span style="color:rgba(233,236,255,0.5);">📊 Genel: @completedMatches / @totalMatches bitti</span>
                <span style="color:rgba(233,236,255,0.5);">✅ %@progressPercent</span>
            }
        </div>
    </div>

    <!-- Tur Bilgi Pill -->
    <div class="header-area">
        <div class="round-pill">
            @quizeiPill
        </div>
    </div>

    <!-- Arena -->
    <div class="arena">

        <!-- ===== SOL YARI ===== -->
        <div class="arena-half">
            <div class="match-card left-card" id="leftCard">
                <div class="card-media">
                    @if (leftHasImage)
                    {
                        <!-- Sadece resim -->
                        <img src="@left!.ImageUrl" alt="@left?.Name" class="thumb-img" />
                    }
                    else if (leftShowVideo)
                    {
                        <!-- Video: thumbnail + play butonu + gizli iframe -->
                        <div class="video-container" id="videoLeft">
                            <img src="https://img.youtube.com/vi/@(left!.YouTubeVideoId)/hqdefault.jpg"
                                 alt="@left?.Name" class="video-thumb" />
                            <button type="button" class="play-btn" onclick="playVideo('videoLeft', '@left!.YouTubeVideoId')"></button>
                            <iframe id="iframeLeft" allowfullscreen allow="autoplay"></iframe>
                        </div>
                    }
                    else
                    {
                        <div class="no-media">Görsel/Video yok</div>
                    }
                </div>
                <div class="card-label">
                    <button type="button" class="select-btn" onclick="selectCard('left')">
                        @left?.Name
                    </button>
                </div>
            </div>
        </div>

        <!-- VS -->
        <div class="vs-area">
            <div class="vs-icon">
                <span class="bolt">⚡</span>
            </div>
            <div class="vs-text">VS</div>
        </div>

        <!-- ===== SAĞ YARI ===== -->
        <div class="arena-half">
            <div class="match-card right-card" id="rightCard">
                <div class="card-media">
                    @if (rightHasImage)
                    {
                        <img src="@right!.ImageUrl" alt="@right?.Name" class="thumb-img" />
                    }
                    else if (rightShowVideo)
                    {
                        <div class="video-container" id="videoRight">
                            <img src="https://img.youtube.com/vi/@(right!.YouTubeVideoId)/hqdefault.jpg"
                                 alt="@right?.Name" class="video-thumb" />
                            <button type="button" class="play-btn" onclick="playVideo('videoRight', '@right!.YouTubeVideoId')"></button>
                            <iframe id="iframeRight" allowfullscreen allow="autoplay"></iframe>
                        </div>
                    }
                    else
                    {
                        <div class="no-media">Görsel/Video yok</div>
                    }
                </div>
                <div class="card-label">
                    <button type="button" class="select-btn" onclick="selectCard('right')">
                        @right?.Name
                    </button>
                </div>
            </div>
        </div>

    </div>

    <!-- Alt Bilgi -->
    <div class="bottom-info">
        <div class="hint">Videoyu dinle, sonra alttaki isim butonuna tıklayarak seçimini yap.</div>
        <div class="made-with">made with <strong>RankArena</strong></div>
    </div>

</div>

<!-- Gizli Formlar -->
<form id="formLeft" class="hidden-form" action="/Play/BracketVote" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="runId" value="@Model.RunId" />
    <input type="hidden" name="matchId" value="@Model.Id" />
    <input type="hidden" name="selectedItemId" value="@Model.LeftItemId" />
</form>

<form id="formRight" class="hidden-form" action="/Play/BracketVote" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="runId" value="@Model.RunId" />
    <input type="hidden" name="matchId" value="@Model.Id" />
    <input type="hidden" name="selectedItemId" value="@Model.RightItemId" />
</form>

<script>
    // ========== VİDEO OYNAT ==========
    function playVideo(containerId, videoId) {
        const container = document.getElementById(containerId);
        if (!container) return;

        const iframe = container.querySelector('iframe');
        if (!iframe) return;

        // iframe'e autoplay ile video yükle
        iframe.src = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0';

        // thumbnail ve play butonunu gizle, iframe'i göster
        container.classList.add('playing');
    }

    // ========== ŞIK SEÇ (sadece isim butonundan) ==========
    let submitted = false;

    function selectCard(side) {
        if (submitted) return;
        submitted = true;

        const leftCard = document.getElementById('leftCard');
        const rightCard = document.getElementById('rightCard');

        // Videoları durdur
        stopAllVideos();

        if (side === 'left') {
            leftCard.classList.add('chosen');
            rightCard.classList.add('not-chosen');
        } else {
            rightCard.classList.add('chosen');
            leftCard.classList.add('not-chosen');
        }

        // Animasyon bittikten sonra formu gönder
        setTimeout(function() {
            var form = side === 'left'
                ? document.getElementById('formLeft')
                : document.getElementById('formRight');
            form.submit();
        }, 700);
    }

    // Tüm videoları durdur
    function stopAllVideos() {
        var iframes = document.querySelectorAll('.video-container iframe');
        iframes.forEach(function(iframe) {
            iframe.src = '';
        });
    }
</script>

</body>
</html>