@model RankArena.Models.Entities.Run
@using RankArena.Models.Entities

@{
    ViewData["Title"] = "Blind Rank Sonuç";

    var slots = ViewBag.Slots as List<BlindSlot> ?? new List<BlindSlot>();
    var winner = ViewBag.Winner as TournamentItem;

    var slug = (ViewBag.Slug as string) ?? Model.Tournament?.Slug ?? "";

    string? YtThumb(string? videoId)
        => string.IsNullOrWhiteSpace(videoId) ? null : $"https://img.youtube.com/vi/{videoId}/hqdefault.jpg";

    string? SlotThumb(TournamentItem? i)
    {
        if (!string.IsNullOrWhiteSpace(i?.ImageUrl)) return i!.ImageUrl;
        if (!string.IsNullOrWhiteSpace(i?.YouTubeVideoId)) return YtThumb(i!.YouTubeVideoId);
        return null;
    }

    var ordered = slots.OrderBy(s => s.Position).ToList();
    int total = ordered.Count;
    int filled = ordered.Count(s => s.TournamentItemId != null);
    int percent = total == 0 ? 0 : (int)Math.Round((filled * 100.0) / total);

    TournamentItem? top1 = ordered.FirstOrDefault(s => s.Position == 1)?.TournamentItem;
    TournamentItem? top2 = ordered.FirstOrDefault(s => s.Position == 2)?.TournamentItem;
    TournamentItem? top3 = ordered.FirstOrDefault(s => s.Position == 3)?.TournamentItem;
}

<style>
    html, body {
        height: 100%;
    }

    body {
        background: #070a18 !important;
    }

    header, footer {
        display: none !important;
    }

    .br-scene {
        min-height: 100vh;
        background: radial-gradient(1100px 650px at 20% 10%, rgba(255, 180, 0, .10), transparent 60%), radial-gradient(900px 600px at 85% 30%, rgba(135, 80, 255, .12), transparent 55%), linear-gradient(135deg, #0b1030, #070a18 55%, #060816);
        padding: 22px 0 36px;
        color: #e9ecff;
    }

    .glass {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 18px 40px rgba(0,0,0,0.35);
        border-radius: 18px;
        overflow: hidden;
        position: relative;
    }

    .exitBtn {
        position: absolute;
        top: 14px;
        left: 14px;
        z-index: 5;
        border: 1px solid rgba(255,255,255,0.14);
        background: rgba(10, 12, 25, 0.55);
        color: rgba(233,236,255,0.95);
        border-radius: 12px;
        padding: 10px 12px;
        font-weight: 900;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: transform .12s ease, filter .12s ease, border-color .12s ease;
        backdrop-filter: blur(6px);
    }

        .exitBtn:hover {
            transform: translateY(-1px);
            filter: brightness(1.03);
            border-color: rgba(255,255,255,0.22);
            color: #fff;
        }

    .topbar {
        padding: 16px 18px 12px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .title {
        margin: 0;
        font-weight: 1000;
        letter-spacing: .4px;
        font-size: 22px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .subtitle {
        margin: 4px 0 0;
        color: rgba(233,236,255,0.72);
        font-size: 13px;
    }

    .pillRow {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        font-size: 12px;
        color: rgba(233,236,255,.92);
        white-space: nowrap;
    }

    .progressTrack {
        height: 10px;
        border-radius: 999px;
        background: rgba(255,255,255,0.08);
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.08);
        margin: 12px 18px 0;
    }

    .progressFill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #22c55e, #60a5fa);
    }

    .content {
        padding: 16px 18px 18px;
        display: grid;
        grid-template-columns: 1fr 420px;
        gap: 16px;
    }

    .panel {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        overflow: hidden;
    }

    .panelHeader {
        padding: 12px 14px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .panelTitle {
        margin: 0;
        font-weight: 1000;
        letter-spacing: .3px;
        font-size: 14px;
        color: rgba(233,236,255,0.92);
    }

    .muted {
        color: rgba(233,236,255,0.70);
        font-size: 12px;
    }

    .rankList {
        padding: 12px 14px 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-height: calc(100vh - 210px);
        overflow: auto;
    }

        .rankList::-webkit-scrollbar {
            width: 10px;
        }

        .rankList::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.10);
            border-radius: 999px;
        }

        .rankList::-webkit-scrollbar-track {
            background: transparent;
        }

    .rankRow {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 10px;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.04);
        position: relative;
    }

        /* ✅ TOP 3 neon */
        .rankRow.top1 {
            border-color: rgba(255, 215, 0, 0.35);
            box-shadow: 0 0 0 1px rgba(255, 215, 0, 0.20), 0 0 0 4px rgba(255, 215, 0, 0.08), 0 18px 40px rgba(0,0,0,0.45);
        }

        .rankRow.top2 {
            border-color: rgba(160, 200, 255, 0.35);
            box-shadow: 0 0 0 1px rgba(160, 200, 255, 0.18), 0 0 0 4px rgba(160, 200, 255, 0.07), 0 18px 40px rgba(0,0,0,0.45);
        }

        .rankRow.top3 {
            border-color: rgba(255, 160, 110, 0.35);
            box-shadow: 0 0 0 1px rgba(255, 160, 110, 0.18), 0 0 0 4px rgba(255, 160, 110, 0.07), 0 18px 40px rgba(0,0,0,0.45);
        }

            .rankRow.top1::after, .rankRow.top2::after, .rankRow.top3::after {
                content: "";
                position: absolute;
                inset: -1px;
                border-radius: 14px;
                pointer-events: none;
                background: radial-gradient(600px 120px at 20% 0%, rgba(255,255,255,0.10), transparent 55%);
                opacity: 0.8;
                mix-blend-mode: screen;
            }

    .rankPos {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 1000;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.10);
        flex: 0 0 auto;
        color: rgba(233,236,255,0.95);
    }

    .rankThumb {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.10);
        background: rgba(255,255,255,0.04);
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(233,236,255,0.65);
        font-weight: 1000;
    }

        .rankThumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .rankText {
        min-width: 0;
    }

    .rankName {
        margin: 0;
        font-weight: 1000;
        font-size: 14px;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .rankMeta {
        margin: 3px 0 0;
        font-size: 12px;
        color: rgba(233,236,255,0.70);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .winnerCard {
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .winnerHero {
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.10);
        background: rgba(255,255,255,0.03);
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.05);
        position: relative;
    }

        .winnerHero img {
            width: 100%;
            height: 240px;
            object-fit: cover;
            display: block;
        }

    .winnerBadge {
        position: absolute;
        left: 12px;
        top: 12px;
        padding: 8px 10px;
        border-radius: 999px;
        background: rgba(0,0,0,0.55);
        border: 1px solid rgba(255,255,255,0.18);
        font-weight: 1000;
        color: rgba(255,255,255,0.95);
        backdrop-filter: blur(6px);
    }

    .winnerName {
        margin: 0;
        font-size: 18px;
        font-weight: 1000;
        letter-spacing: .3px;
    }

    .ctaRow {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btnGlow {
        border: none;
        border-radius: 14px;
        padding: 12px 14px;
        font-weight: 1000;
        color: #fff;
        background: linear-gradient(90deg, #ff2d55, #ff8a00);
        box-shadow: 0 14px 30px rgba(255,90,0,0.18);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: transform .12s ease, filter .12s ease;
    }

        .btnGlow:hover {
            transform: translateY(-1px);
            filter: brightness(1.03);
            color: #fff;
        }

    .btnGhost {
        border-radius: 14px;
        padding: 12px 14px;
        font-weight: 1000;
        color: rgba(233,236,255,0.95);
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.10);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: transform .12s ease, filter .12s ease, border-color .12s ease;
    }

        .btnGhost:hover {
            transform: translateY(-1px);
            filter: brightness(1.03);
            border-color: rgba(255,255,255,0.18);
            color: #fff;
        }

    .top3 {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .top3Row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.04);
    }

        /* ✅ Top3 mini neon */
        .top3Row.top1 {
            border-color: rgba(255, 215, 0, 0.35);
            box-shadow: 0 0 0 1px rgba(255,215,0,0.18), 0 0 0 4px rgba(255,215,0,0.07);
        }

        .top3Row.top2 {
            border-color: rgba(160, 200, 255, 0.35);
            box-shadow: 0 0 0 1px rgba(160,200,255,0.16), 0 0 0 4px rgba(160,200,255,0.06);
        }

        .top3Row.top3 {
            border-color: rgba(255, 160, 110, 0.35);
            box-shadow: 0 0 0 1px rgba(255,160,110,0.16), 0 0 0 4px rgba(255,160,110,0.06);
        }

    .top3Medal {
        width: 40px;
        height: 40px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 1000;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.10);
        flex: 0 0 auto;
    }

    .top3Text {
        min-width: 0;
    }

    .top3Name {
        margin: 0;
        font-weight: 1000;
        font-size: 13px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @@media (max-width: 992px) {
        .content {
            grid-template-columns: 1fr;
        }

        .rankList {
            max-height: none;
        }

        .winnerHero img {
            height: 220px;
        }
    }
</style>

<div class="br-scene">
    <div class="container">
        <div class="glass">

            <a class="exitBtn"
               asp-controller="Tournaments"
               asp-action="Details"
               asp-route-slug="@slug">
                ← Turnuvaya Dön
            </a>

            <div class="topbar">
                <div>
                    <h2 class="title">👁️ Blind Rank Sonuç</h2>
                    <p class="subtitle m-0">
                        Sıralaman kilitlendi. İstersen tekrar oynayıp farklı bir sonuç çıkarabilirsin.
                    </p>
                </div>

                <div class="pillRow">
                    <span class="pill">RunId: @Model.Id</span>
                    <span class="pill">✅ @filled / @total</span>
                    <span class="pill">📈 %@percent</span>
                </div>
            </div>

            <div class="progressTrack">
                <div class="progressFill" style="width:@percent%"></div>
            </div>

            <div class="content">
                <!-- SOL: Sıralama -->
                <div class="panel">
                    <div class="panelHeader">
                        <h3 class="panelTitle m-0">Sıralama</h3>
                        <span class="muted">1 en iyi, @total en düşük</span>
                    </div>

                    <div class="rankList">
                        @foreach (var s in ordered)
                        {
                            var ti = s.TournamentItem;
                            var thumb = SlotThumb(ti);
                            var isEmpty = s.TournamentItemId == null;

                            var topClass = s.Position == 1 ? "top1"
                            : s.Position == 2 ? "top2"
                            : s.Position == 3 ? "top3"
                            : "";

                            <div class="rankRow @topClass" style="opacity:@(isEmpty ? "0.75" : "1");">
                                <div class="rankPos">@s.Position</div>

                                <div class="rankThumb">
                                    @if (!isEmpty && !string.IsNullOrWhiteSpace(thumb))
                                    {
                                        <img src="@thumb" alt="thumb" />
                                    }
                                    else if (!isEmpty)
                                    {
                                        <span>✓</span>
                                    }
                                    else
                                    {
                                        <span>?</span>
                                    }
                                </div>

                                <div class="rankText">
                                    <p class="rankName">
                                        @(isEmpty ? "Boş" : (ti?.Name ?? "Seçildi"))
                                    </p>
                                    <p class="rankMeta">
                                        @(isEmpty ? "Bu slot doldurulmamış" : "Kilitledin")
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- SAĞ: Winner + Top3 -->
                <div class="panel">
                    <div class="panelHeader">
                        <h3 class="panelTitle m-0">Özet</h3>
                        <span class="muted">Top 3</span>
                    </div>

                    <div class="winnerCard">
                        @{
                            var w = winner ?? top1;
                            var wThumb = SlotThumb(w);
                        }

                        <div class="winnerHero">
                            <div class="winnerBadge">🏆 1. Sıra</div>

                            @if (w != null && !string.IsNullOrWhiteSpace(wThumb))
                            {
                                <img src="@wThumb" alt="winner" />
                            }
                            else
                            {
                                <div style="height:240px;display:flex;align-items:center;justify-content:center;color:rgba(233,236,255,0.75);">
                                    Görsel yok
                                </div>
                            }
                        </div>

                        <h4 class="winnerName m-0">
                            @(w?.Name ?? "Winner bulunamadı")
                        </h4>

                        <div class="top3">
                            <div class="top3Row top1">
                                <div class="top3Medal">🥇</div>
                                <div class="top3Text">
                                    <p class="top3Name m-0">@(top1?.Name ?? "—")</p>
                                </div>
                            </div>

                            <div class="top3Row top2">
                                <div class="top3Medal">🥈</div>
                                <div class="top3Text">
                                    <p class="top3Name m-0">@(top2?.Name ?? "—")</p>
                                </div>
                            </div>

                            <div class="top3Row top3">
                                <div class="top3Medal">🥉</div>
                                <div class="top3Text">
                                    <p class="top3Name m-0">@(top3?.Name ?? "—")</p>
                                </div>
                            </div>
                        </div>

                        <div class="ctaRow">
                            <a class="btnGlow"
                               asp-controller="Play"
                               asp-action="Start"
                               asp-route-slug="@slug"
                               asp-route-mode="blind"
                               asp-route-value="@(Model.TotalSlots ?? 10)">
                                🔁 Tekrar Oyna
                            </a>

                            <a class="btnGhost"
                               asp-controller="Tournaments"
                               asp-action="Details"
                               asp-route-slug="@slug">
                                📄 Turnuva Sayfası
                            </a>
                        </div>

                        <div class="muted">
                            İpucu: YouTube video eklediysen otomatik kapak resmi kullanıyoruz (hqdefault).
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>