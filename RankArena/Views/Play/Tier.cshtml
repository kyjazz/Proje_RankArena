@model RankArena.Models.Entities.TierRunItem
@using RankArena.Models.Entities

@{
    ViewData["Title"] = "Tier List";

    var item = Model.TournamentItem;

    var slug = ViewBag.Slug as string;

    int total = ViewBag.Total ?? 0;
    int done = ViewBag.Done ?? 0;
    int remaining = ViewBag.Remaining ?? Math.Max(0, total - done);
    int percent = ViewBag.Percent ?? 0;
    int skipCount = ViewBag.SkipCount ?? 0;

    var placed = ViewBag.Placed as List<TierSlot> ?? new List<TierSlot>();

    // ✅ Sürükle & Bırak için henüz yerleştirilmemiş tüm item'ler
    var unplaced = ViewBag.UnplacedPool as List<TierRunItem> ?? new List<TierRunItem>();

    // ✅ Board'daki chip'lerin TierRunItemId'sini bulmak için pool
    var pool = unplaced.Concat(
        placed.Select(p => new TierRunItem { })
    ).ToList();

    string? YtThumb(string? videoId)
        => string.IsNullOrWhiteSpace(videoId) ? null : $"https://img.youtube.com/vi/{videoId}/hqdefault.jpg";

    string? ItemThumb(TournamentItem? i)
    {
        if (!string.IsNullOrWhiteSpace(i?.ImageUrl)) return i!.ImageUrl;
        if (!string.IsNullOrWhiteSpace(i?.YouTubeVideoId)) return YtThumb(i!.YouTubeVideoId);
        return null;
    }

    bool hasVideo = !string.IsNullOrWhiteSpace(item?.YouTubeVideoId);
    bool hasImage = !string.IsNullOrWhiteSpace(item?.ImageUrl);

    // Board listeleri
    List<TierSlot> TierOf(Tier t) => placed
        .Where(x => x.Tier == t)
        .OrderByDescending(x => x.PlacedAt)
        .ToList();

    var tiers = new[] { Tier.S, Tier.A, Tier.B, Tier.C, Tier.D };

    string TierClass(Tier t) => t switch
    {
        Tier.S => "tierS",
        Tier.A => "tierA",
        Tier.B => "tierB",
        Tier.C => "tierC",
        Tier.D => "tierD",
        _ => "tierD"
    };

    // ✅ YENİ: TournamentItemId → TierRunItemId eşlemesi (board chip'leri için)
    var allPoolItems = ViewBag.AllPool as List<TierRunItem> ?? new List<TierRunItem>();
}

<style>
    html, body {
        height: 100%;
    }

    body {
        margin: 0 !important;
        padding: 0 !important;
        background: #070a18 !important;
        color: #e9ecff;
    }

    header, nav, .navbar, footer {
        display: none !important;
    }

    .scene {
        min-height: 100vh;
        background: radial-gradient(1100px 650px at 20% 10%, rgba(255, 180, 0, .10), transparent 60%), radial-gradient(900px 600px at 85% 30%, rgba(135, 80, 255, .12), transparent 55%), linear-gradient(135deg, #0b1030, #070a18 55%, #060816);
        padding: 18px 0 28px;
        position: relative;
    }

    .exitBtn {
        position: fixed;
        top: 16px;
        left: 16px;
        z-index: 9999;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.10);
        color: rgba(233,236,255,0.95);
        text-decoration: none;
        font-weight: 900;
        box-shadow: 0 18px 40px rgba(0,0,0,0.35);
        backdrop-filter: blur(10px);
        transition: transform .12s ease, filter .12s ease, border-color .12s ease;
    }

        .exitBtn:hover {
            transform: translateY(-1px);
            filter: brightness(1.05);
            border-color: rgba(255,255,255,0.18);
            color: #fff;
            text-decoration: none;
        }

    .glass {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 18px 40px rgba(0,0,0,0.35);
        border-radius: 18px;
        overflow: hidden;
    }

    .topbar {
        padding: 14px 16px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

    .title {
        margin: 0;
        font-weight: 1000;
        letter-spacing: .4px;
        font-size: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .pillRow {
