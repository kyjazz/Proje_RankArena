    /* Sürükle & Bırak paneli */
    .dragPool {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        max-height: 400px;
        overflow-y: auto;
        padding: 4px;
    }

        .dragPool::-webkit-scrollbar {
            width: 6px;
        }

        .dragPool::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.12);
            border-radius: 99px;
        }

    .dragChip {
        width: 86px;
        height: 66px;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.05);
        position: relative;
        flex: 0 0 auto;
        cursor: grab;
        transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease, opacity .12s ease;
