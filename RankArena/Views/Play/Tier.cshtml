    }

        .dragChip:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.4);
            border-color: rgba(255, 200, 0, 0.35);
        }

        .dragChip:active {
            cursor: grabbing;
        }

        .dragChip img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            opacity: .95;
            pointer-events: none;
