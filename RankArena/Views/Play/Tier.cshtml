            border-color: rgba(255, 200, 0, 0.40);
            box-shadow: inset 0 0 24px rgba(255, 200, 0, 0.06), 0 0 0 2px rgba(255, 200, 0, 0.15);
        }

    .chip {
        width: 86px;
        height: 60px;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.10);
        background: rgba(255,255,255,0.04);
