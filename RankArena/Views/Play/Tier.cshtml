        .dragChip.dragging {
            opacity: 0.35;
            transform: scale(0.90);
        }

    .dragHint {
        text-align: center;
        padding: 6px;
        color: rgba(233,236,255,0.55);
        font-size: 11px;
        font-weight: 700;
    }

    .dragEmptyMsg {
        text-align: center;
        padding: 20px;
        color: rgba(233,236,255,0.55);
        font-weight: 900;
        font-size: 13px;
    }

    @@media (max-width: 992px) {
        .layout {
            grid-template-columns: 1fr;
        }

        .side {
            position: static;
        }

        .tierRow {
            grid-template-columns: 76px 1fr;
        }

        .chip {
            width: 78px;
            height: 56px;
        }
    }
</style>

<div class="scene">

    <a class="exitBtn"
       href="@(string.IsNullOrWhiteSpace(slug) ? Url.Action("Index","Home") : $"/t/{slug}")"
       title="Turnuvaya geri dön">
        ← Çıkış
    </a>

    <div class="container">
        <div class="glass">

            <div class="topbar">
                <h2 class="title">🏷️ Tier List</h2>
                <div class="pillRow">
                    <span class="pill">RunId: @Model.RunId</span>
                    <span class="pill">✅ @done / @total</span>
                    <span class="pill">⏳ Kalan: @remaining</span>
                    <span class="pill">📈 %@percent</span>
                    @if (skipCount > 0)
                    {
                        <span class="pill">⏭ Geçilen: @skipCount</span>
                    }
                </div>
            </div>

            <div class="layout">

                <!-- SOL: TIER BOARD -->
                <div class="board">
                    <div class="boardHeader">
                        <h3 class="boardTitle m-0">Tier Board</h3>
                        <span class="muted">Yerleştirilenler burada görünür — sürükleyerek taşıyabilirsiniz</span>
                    </div>

                    @foreach (var t in tiers)
                    {
                        var list = TierOf(t);
                        <div class="tierRow @TierClass(t)">
                            <div class="tierLabel">@t</div>

                            <div class="tierZone" data-tier="@t">
                                @if (list.Count == 0)
                                {
                                    <div class="muted tierZoneEmpty" style="padding:10px;">Boş</div>
                                }
                                else
                                {
                                    @foreach (var row in list)
                                    {
                                        var ti = row.TournamentItem;
                                        var th = ItemThumb(ti);
                                        var isVid = !string.IsNullOrWhiteSpace(ti?.YouTubeVideoId);

                                        // ✅ Board chip'inin TierRunItemId'sini bul
                                        var triForChip = allPoolItems.FirstOrDefault(x => x.TournamentItemId == row.TournamentItemId);
                                        var triId = triForChip?.Id ?? 0;

                                        <div class="chip"
                                             draggable="true"
                                             data-tier-run-item-id="@triId"
                                             data-name="@(ti?.Name ?? "—")"
                                             title="@(ti?.Name ?? "")">
                                            @if (!string.IsNullOrWhiteSpace(th))
                                            {
                                                <img src="@th" alt="thumb" />
                                            }
                                            else
                                            {
                                                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-weight:1000;color:rgba(233,236,255,0.75);">
                                                    ✓
                                                </div>
                                            }

                                            @if (isVid)
                                            {
                                                <div class="playBadge">▶</div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }

                    <div style="padding:12px 14px; border-top:1px solid rgba(255,255,255,0.06);" class="muted">
                        Not: Yanlış tier seçersen, item'i sürükleyerek başka tier'e taşıyabilirsin.
                    </div>
                </div>

                <!-- SAĞ: SEÇİM PANELİ -->
                <div class="side">
                    <div class="sideTabs">
                        <div class="tab active" id="tabSequential" onclick="switchTab('sequential')">Sırasıyla</div>
                        <div class="tab" id="tabDragDrop" onclick="switchTab('dragdrop')">Sürükle &amp; Bırak</div>
                    </div>

                    <!-- ========== SIRASIYLA MODU ========== -->
                    <div class="sideBody" id="panelSequential">
                        <div class="playerCard">
                            @if (hasVideo)
                            {
                                <div class="ratio ratio-16x9">
                                    <iframe src="https://www.youtube.com/embed/@(item!.YouTubeVideoId)"
                                            allowfullscreen></iframe>
                                </div>
                            }
                            else if (hasImage)
                            {
                                <img src="@item!.ImageUrl"
                                     style="width:100%;height:220px;object-fit:cover;display:block;"
                                     alt="item" />
                            }
                            else
                            {
                                <div style="height:220px;display:flex;align-items:center;justify-content:center;color:rgba(233,236,255,0.75);font-weight:1000;">
                                    Görsel / Video yok
                                </div>
                            }

                            <div class="playerTitle">@item?.Name</div>
                        </div>

                        <div class="muted" style="text-align:center;">
                            Bu öğeyi yerleştirmek için aşağıdaki katmana tıklayın veya GEÇ ile pas geçin
                        </div>

                        <div class="quickGrid">
                            <form asp-action="TierPlace" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="runId" value="@Model.RunId" />
                                <input type="hidden" name="tierRunItemId" value="@Model.Id" />
