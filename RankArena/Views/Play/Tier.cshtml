        .dragChip::after {
            content: attr(data-name);
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            padding: 5px 5px;
            font-size: 9px;
            font-weight: 900;
            color: rgba(255,255,255,0.92);
