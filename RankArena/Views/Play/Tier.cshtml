            box-shadow: 0 6px 16px rgba(0,0,0,0.35);
        }

        .chip:active {
            cursor: grabbing;
        }

        .chip img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            opacity: .95;
            pointer-events: none;
