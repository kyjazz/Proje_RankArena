        border-color: rgba(34, 197, 94, 0.45);
        box-shadow: inset 0 0 24px rgba(34, 197, 94, 0.08), 0 0 0 2px rgba(34, 197, 94, 0.18);
    }

    .tierD .tierZone.drag-over {
        background: rgba(59, 130, 246, 0.10);
        border-color: rgba(59, 130, 246, 0.45);
        box-shadow: inset 0 0 24px rgba(59, 130, 246, 0.08), 0 0 0 2px rgba(59, 130, 246, 0.18);
