<!-- Sürükle & Bırak gizli form -->
<form id="dragDropForm" asp-action="TierPlace" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="runId" value="@Model.RunId" id="ddRunId" />
    <input type="hidden" name="tierRunItemId" value="" id="ddTierRunItemId" />
    <input type="hidden" name="tier" value="" id="ddTier" />
</form>

<script>
    // ========================================
    // TAB GEÇİŞ
    // ========================================
    function switchTab(mode) {
        const seqPanel = document.getElementById("panelSequential");
        const ddPanel = document.getElementById("panelDragDrop");
        const tabSeq = document.getElementById("tabSequential");
        const tabDD = document.getElementById("tabDragDrop");

        if (mode === "sequential") {
            seqPanel.style.display = "";
            ddPanel.style.display = "none";
            tabSeq.classList.add("active");
            tabDD.classList.remove("active");
        } else {
            seqPanel.style.display = "none";
            ddPanel.style.display = "";
            tabSeq.classList.remove("active");
            tabDD.classList.add("active");
        }
    }

    // ========================================
    // KISAYOL TUŞLARI (1-5: tier, 0: GEÇ)
    // ========================================
    document.addEventListener("keydown", function (e) {
        const tag = (e.target && e.target.tagName) ? e.target.tagName.toLowerCase() : "";
        if (tag === "input" || tag === "textarea") return;
        const seqPanel = document.getElementById("panelSequential");
        if (seqPanel.style.display === "none") return;

        if (e.key === "1") document.getElementById("btnS")?.click();
        if (e.key === "2") document.getElementById("btnA")?.click();
        if (e.key === "3") document.getElementById("btnB")?.click();
        if (e.key === "4") document.getElementById("btnC")?.click();
        if (e.key === "5") document.getElementById("btnD")?.click();
        if (e.key === "0") document.getElementById("btnSkip")?.click();
    });

    // ========================================
    // SÜRÜKLE & BIRAK — Hem panel hem board chip'leri
    // ========================================
    (function () {
        let draggedItemId = null;

        // ✅ Draggable chip'lere event ekle (hem .dragChip hem .chip[draggable])
        function attachDragStart(el) {
            el.addEventListener("dragstart", function (e) {
                draggedItemId = this.getAttribute("data-tier-run-item-id");
                if (!draggedItemId || draggedItemId === "0") {
                    e.preventDefault();
                    return;
                }
                e.dataTransfer.setData("text/plain", draggedItemId);
                e.dataTransfer.effectAllowed = "move";
                setTimeout(() => this.classList.add("dragging"), 0);
            });

            el.addEventListener("dragend", function () {
                this.classList.remove("dragging");
                draggedItemId = null;
                // Tüm hover efektlerini kaldır
                document.querySelectorAll(".tierZone.drag-over").forEach(z => z.classList.remove("drag-over"));
                document.querySelectorAll(".tierRow.drag-highlight").forEach(r => r.classList.remove("drag-highlight"));
            });
        }

        // Panel'deki dragChip'ler
        document.querySelectorAll(".dragChip").forEach(attachDragStart);

        // ✅ Board'daki chip'ler (zaten yerleştirilmiş, tier'ler arası taşıma)
        document.querySelectorAll(".chip[draggable='true']").forEach(attachDragStart);

        // ✅ Drop hedefleri: .tierZone
        document.querySelectorAll(".tierZone").forEach(function (zone) {
            zone.addEventListener("dragover", function (e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = "move";
                this.classList.add("drag-over");

                // Üst tierRow'u da vurgula
                const row = this.closest(".tierRow");
                if (row) row.classList.add("drag-highlight");

                // "Boş" yazısını gizle
                const empty = this.querySelector(".tierZoneEmpty");
                if (empty) empty.style.display = "none";
            });

            zone.addEventListener("dragleave", function (e) {
                if (!this.contains(e.relatedTarget)) {
                    this.classList.remove("drag-over");
                    const row = this.closest(".tierRow");
                    if (row) row.classList.remove("drag-highlight");

                    const empty = this.querySelector(".tierZoneEmpty");
                    const chips = this.querySelectorAll(".chip");
                    if (empty && chips.length === 0) empty.style.display = "";
                }
            });

            zone.addEventListener("drop", function (e) {
                e.preventDefault();
                this.classList.remove("drag-over");
                const row = this.closest(".tierRow");
                if (row) row.classList.remove("drag-highlight");

                const tierRunItemId = e.dataTransfer.getData("text/plain");
                if (!tierRunItemId || tierRunItemId === "0") return;

                const tierValue = this.getAttribute("data-tier");
                if (!tierValue) return;

                // Gizli formu doldur ve submit et
                document.getElementById("ddTierRunItemId").value = tierRunItemId;
                document.getElementById("ddTier").value = tierValue;
                document.getElementById("dragDropForm").submit();
            });
        });
    })();
</script>