        font-weight: 1000;
        letter-spacing: .3px;
        font-size: 14px;
    }

    .muted {
        color: rgba(233,236,255,0.70);
        font-size: 12px;
    }

    .tierRow {
        display: grid;
        grid-template-columns: 92px 1fr;
        gap: 10px;
        padding: 10px;
        border-top: 1px solid rgba(255,255,255,0.06);
        align-items: stretch;
        transition: border-color .15s ease;
    }

        .tierRow.drag-highlight {
            border-color: rgba(255, 200, 0, 0.30);
        }

    .tierLabel {
        border-radius: 14px;
        font-weight: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        letter-spacing: .8px;
        font-size: 20px;
        border: 1px solid rgba(255,255,255,0.14);
        background: rgba(255,255,255,0.06);
        user-select: none;
    }

    .tierZone {
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.10);
        background: rgba(255,255,255,0.03);
        padding: 8px;
        min-height: 86px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-content: flex-start;
