@model RankArena.Models.Entities.Run
@using RankArena.Models.Entities

@{
    ViewData["Title"] = "Tier List Sonuç";

    var slug = (ViewBag.Slug as string) ?? Model.Tournament?.Slug ?? "";
    var placements = ViewBag.Placements as List<TierSlot> ?? new List<TierSlot>();

    string? YtThumb(string? videoId)
        => string.IsNullOrWhiteSpace(videoId) ? null : $"https://img.youtube.com/vi/{videoId}/hqdefault.jpg";

    string? ItemThumb(TournamentItem? i)
    {
        if (!string.IsNullOrWhiteSpace(i?.ImageUrl)) return i!.ImageUrl;
        if (!string.IsNullOrWhiteSpace(i?.YouTubeVideoId)) return YtThumb(i!.YouTubeVideoId);
        return null;
    }

    List<TierSlot> TierOf(Tier t) => placements
        .Where(x => x.Tier == t)
        .OrderByDescending(x => x.PlacedAt)
        .ToList();

    var tiers = new[] { Tier.S, Tier.A, Tier.B, Tier.C, Tier.D };

    bool finished = Model.FinishedAt != null;

    string TierClass(Tier t) => t switch
    {
        Tier.S => "tierS",
        Tier.A => "tierA",
        Tier.B => "tierB",
        Tier.C => "tierC",
        Tier.D => "tierD",
        _ => "tierD"
    };
}

<style>
    html, body {
        height: 100%;
    }

    body {
        margin: 0 !important;
        padding: 0 !important;
        background: #070a18 !important;
        color: #e9ecff;
    }

    header, nav, .navbar, footer {
        display: none !important;
    }

    .scene {
        min-height: 100vh;
        background: radial-gradient(1100px 650px at 20% 10%, rgba(255, 180, 0, .10), transparent 60%), radial-gradient(900px 600px at 85% 30%, rgba(135, 80, 255, .12), transparent 55%), linear-gradient(135deg, #0b1030, #070a18 55%, #060816);
        padding: 18px 0 28px;
        position: relative;
    }

    .exitBtn {
        position: fixed;
        top: 16px;
        left: 16px;
        z-index: 9999;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.10);
        color: rgba(233,236,255,0.95);
        text-decoration: none;
        font-weight: 900;
        box-shadow: 0 18px 40px rgba(0,0,0,0.35);
        backdrop-filter: blur(10px);
        transition: transform .12s ease, filter .12s ease, border-color .12s ease;
    }

        .exitBtn:hover {
            transform: translateY(-1px);
            filter: brightness(1.05);
            border-color: rgba(255,255,255,0.18);
            color: #fff;
            text-decoration: none;
        }

    .glass {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: 0 18px 40px rgba(0,0,0,0.35);
        border-radius: 18px;
        overflow: hidden;
    }

    .topbar {
        padding: 16px 18px 12px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .title {
        margin: 0;
        font-weight: 1000;
        letter-spacing: .4px;
        font-size: 22px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .subtitle {
        margin: 4px 0 0;
        color: rgba(233,236,255,0.72);
        font-size: 13px;
    }

    .ctaRow {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-end;
    }

    .btnGlow {
        border: none;
        border-radius: 14px;
        padding: 12px 14px;
        font-weight: 1000;
        color: #fff;
        background: linear-gradient(90deg, #ff2d55, #ff8a00);
        box-shadow: 0 14px 30px rgba(255,90,0,0.18);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: transform .12s ease, filter .12s ease;
    }

        .btnGlow:hover {
            transform: translateY(-1px);
            filter: brightness(1.03);
            color: #fff;
        }

    .btnGhost {
        border-radius: 14px;
        padding: 12px 14px;
        font-weight: 1000;
        color: rgba(233,236,255,0.95);
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.10);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: transform .12s ease, filter .12s ease, border-color .12s ease;
    }

        .btnGhost:hover {
            transform: translateY(-1px);
            filter: brightness(1.03);
            border-color: rgba(255,255,255,0.18);
            color: #fff;
            text-decoration: none;
        }

    .board {
        margin: 14px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        overflow: hidden;
    }

    .tierRow {
        display: grid;
        grid-template-columns: 92px 1fr;
        gap: 10px;
        padding: 10px;
        border-top: 1px solid rgba(255,255,255,0.06);
        align-items: stretch;
    }

    .tierLabel {
        border-radius: 14px;
        font-weight: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        letter-spacing: .8px;
        font-size: 20px;
        border: 1px solid rgba(255,255,255,0.14);
        background: rgba(255,255,255,0.06);
        user-select: none;
    }

    .tierZone {
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.10);
        background: rgba(255,255,255,0.03);
        padding: 8px;
        min-height: 86px;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-content: flex-start;
    }

    .chip {
        width: 86px;
        height: 60px;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.10);
        background: rgba(255,255,255,0.04);
        position: relative;
        flex: 0 0 auto;
    }

        .chip img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            opacity: .95;
        }

        .chip::after {
            content: attr(data-name);
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            padding: 6px 6px;
            font-size: 10px;
            font-weight: 900;
            color: rgba(255,255,255,0.92);
            background: linear-gradient(180deg, transparent, rgba(0,0,0,0.65));
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .playBadge {
        position: absolute;
        top: 6px;
        right: 6px;
        width: 22px;
        height: 22px;
        border-radius: 999px;
        background: rgba(0,0,0,0.55);
        border: 1px solid rgba(255,255,255,0.16);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        color: rgba(255,255,255,0.95);
        backdrop-filter: blur(6px);
    }

    .tierS .tierLabel {
        background: rgba(255, 45, 85, 0.18);
        border-color: rgba(255, 45, 85, 0.35);
    }

    .tierA .tierLabel {
        background: rgba(255, 138, 0, 0.18);
        border-color: rgba(255, 138, 0, 0.35);
    }

    .tierB .tierLabel {
        background: rgba(245, 158, 11, 0.16);
        border-color: rgba(245, 158, 11, 0.32);
    }

    .tierC .tierLabel {
        background: rgba(34, 197, 94, 0.16);
        border-color: rgba(34, 197, 94, 0.32);
    }

    .tierD .tierLabel {
        background: rgba(59, 130, 246, 0.16);
        border-color: rgba(59, 130, 246, 0.32);
    }

    @@media (max-width: 992px) {
        .tierRow {
            grid-template-columns: 76px 1fr;
        }

        .chip {
            width: 78px;
            height: 56px;
        }
    }
</style>

<div class="scene">

    <a class="exitBtn"
       href="@(string.IsNullOrWhiteSpace(slug) ? Url.Action("Index","Home") : $"/t/{slug}")">
        ← Çıkış / Turnuvaya Dön
    </a>

    <div class="container">
        <div class="glass">

            <div class="topbar">
                <div>
                    <h2 class="title">🏷️ Tier List @(finished ? "Sonuç" : "Durum")</h2>
                    <p class="subtitle m-0">
                        @(finished
                            ? "Liste tamamlandı."
                            : "Henüz bitmedi. Devam ederek tüm item’ları tier’lere yerleştirebilirsin.")
                    </p>
                </div>

                <div class="ctaRow">
                    @if (!finished)
                    {
                        <a class="btnGlow"
                           asp-controller="Play"
                           asp-action="Tier"
                           asp-route-runId="@Model.Id">
                            ▶️ Devam Et
                        </a>
                    }

                    <a class="btnGhost"
                       asp-controller="Play"
                       asp-action="Start"
                       asp-route-slug="@slug"
                       asp-route-mode="tier">
                        🔁 Tekrar Oyna
                    </a>
                </div>
            </div>

            <div class="board">
                @foreach (var t in tiers)
                {
                    var list = TierOf(t);

                    <div class="tierRow @TierClass(t)">
                        <div class="tierLabel">@t</div>

                        <div class="tierZone">
                            @if (list.Count == 0)
                            {
                                <div class="muted" style="padding:10px;">Boş</div>
                            }
                            else
                            {
                                @foreach (var row in list)
                                {
                                    var ti = row.TournamentItem;
                                    var th = ItemThumb(ti);
                                    var isVid = !string.IsNullOrWhiteSpace(ti?.YouTubeVideoId);

                                    <div class="chip" data-name="@(ti?.Name ?? "—")" title="@(ti?.Name ?? "")">
                                        @if (!string.IsNullOrWhiteSpace(th))
                                        {
                                            <img src="@th" alt="thumb" />
                                        }
                                        else
                                        {
                                            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-weight:1000;color:rgba(233,236,255,0.75);">
                                                ✓
                                            </div>
                                        }

                                        @if (isVid)
                                        {
                                            <div class="playBadge">▶</div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>