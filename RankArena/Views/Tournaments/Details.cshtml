@model RankArena.Models.ViewModels.TournamentDetailsVm
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@{
    ViewData["Title"] = Model.Tournament.Title;
    var t = Model.Tournament;
    var stats = ViewBag.Stats as RankArena.Models.ViewModels.TournamentStatsVm;
}

@functions {
    string? GetItemThumb(string? imageUrl, string? youtubeVideoId)
    {
        if (!string.IsNullOrWhiteSpace(imageUrl)) return imageUrl;
        if (!string.IsNullOrWhiteSpace(youtubeVideoId))
            return $"https://img.youtube.com/vi/{youtubeVideoId}/hqdefault.jpg";
        return null;
    }
}

<style>
    /* ========== GENEL ========== */
    .details-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px 16px;
    }

    /* ========== ÜST BADGE ========== */
    .top-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,176,32,0.12);
        color: #ffb020;
        font-weight: 700;
        font-size: 0.78rem;
        padding: 5px 14px;
        border-radius: 20px;
        border: 1px solid rgba(255,176,32,0.25);
        margin-bottom: 16px;
    }

    /* ========== ANA LAYOUT: SOL + ORTA + SAĞ ========== */
    .detail-grid {
        display: grid;
        grid-template-columns: 320px 1fr 340px;
        gap: 28px;
        align-items: start;
    }

    @@media (max-width: 1100px) {
        .detail-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ========== SOL KOLON ========== */
    .left-col .cover-img {
        width: 100%;
        aspect-ratio: 3/4;
        object-fit: cover;
        border-radius: 16px;
        border: 2px solid rgba(255,255,255,0.08);
    }

    .left-col .no-cover {
        width: 100%;
        aspect-ratio: 3/4;
        background: rgba(255,255,255,0.04);
        border-radius: 16px;
        border: 2px solid rgba(255,255,255,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
    }

    .btn-play-big {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        margin-top: 14px;
        padding: 16px;
        background: linear-gradient(135deg, #ff6b35, #ff4500);
        color: #fff;
        font-weight: 800;
        font-size: 1.1rem;
        border: none;
        border-radius: 14px;
        cursor: pointer;
        text-decoration: none;
        transition: all .2s;
    }

        .btn-play-big:hover {
            background: linear-gradient(135deg, #ff4500, #ff6b35);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(255,69,0,0.35);
            color: #fff;
            text-decoration: none;
        }

    /* ========== ORTA KOLON ========== */
    .center-col h1 {
        color: #e9ecff;
        font-weight: 900;
        font-size: 1.7rem;
        margin-bottom: 12px;
        line-height: 1.3;
    }

    .mode-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 16px;
    }

    .mode-tag {
        background: rgba(255,176,32,0.1);
        color: #ffb020;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
        border: 1px solid rgba(255,176,32,0.2);
        text-decoration: none;
        transition: all .15s;
        cursor: pointer;
    }

        .mode-tag:hover {
            background: rgba(255,176,32,0.2);
            color: #ffc040;
            text-decoration: none;
        }

    .detail-desc {
        color: rgba(233,236,255,0.7);
        font-size: 0.92rem;
        line-height: 1.7;
        margin-bottom: 20px;
        white-space: pre-line;
    }

    .creator-box {
        display: flex;
        align-items: center;
        gap: 12px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 20px;
    }

    .creator-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(255,176,32,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #ffb020;
        font-size: 1.1rem;
    }

    .creator-label {
        font-size: 0.72rem;
        color: rgba(233,236,255,0.45);
    }

    .creator-name {
        font-weight: 700;
        color: #e9ecff;
        font-size: 0.95rem;
    }

    /* Meta bilgiler */
    .meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 10px;
        padding: 8px 14px;
        font-size: 0.8rem;
        color: rgba(233,236,255,0.7);
    }

        .meta-item span.val {
            color: #e9ecff;
            font-weight: 700;
        }

    /* Oyun modlari kartlari */
    .modes-section h4 {
        color: #e9ecff;
        font-weight: 800;
        margin-bottom: 14px;
        font-size: 1.1rem;
    }

    .mode-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
        margin-bottom: 20px;
    }

    .mode-card-v2 {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 18px 14px;
        text-align: center;
        transition: all .2s;
    }

        .mode-card-v2:hover {
            border-color: rgba(255,176,32,0.3);
            background: rgba(255,176,32,0.04);
        }

        .mode-card-v2 h6 {
            color: #e9ecff;
            font-weight: 700;
            font-size: 0.9rem;
            margin-bottom: 6px;
        }

        .mode-card-v2 p {
            color: rgba(233,236,255,0.5);
            font-size: 0.75rem;
            margin-bottom: 10px;
        }

        .mode-card-v2 .btn-mode {
            background: #ffb020;
            color: #070b1a;
            font-weight: 700;
            border: none;
            padding: 6px 16px;
            border-radius: 8px;
            font-size: 0.78rem;
            text-decoration: none;
            display: inline-block;
            transition: all .15s;
        }

            .mode-card-v2 .btn-mode:hover {
                background: #ffc040;
                text-decoration: none;
            }

    /* ========== SAG KOLON ========== */
    .right-col section {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .right-col h5 {
        color: #ffb020;
        font-weight: 800;
        font-size: 1rem;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ========== SPOILER GIZLEME ========== */
    .spoiler-wrapper {
        position: relative;
    }

    .spoiler-content {
        filter: blur(8px);
        user-select: none;
        pointer-events: none;
        transition: filter 0.4s ease;
    }

        .spoiler-content.revealed {
            filter: none;
            user-select: auto;
            pointer-events: auto;
        }

    .spoiler-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 10;
        background: rgba(7,11,26,0.3);
        border-radius: 12px;
        transition: opacity 0.3s ease;
    }

        .spoiler-overlay.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .spoiler-overlay p {
            color: rgba(233,236,255,0.7);
            font-size: 0.85rem;
            margin-bottom: 10px;
            text-align: center;
        }

    .btn-reveal {
        background: rgba(255,176,32,0.15);
        border: 2px solid #ffb020;
        color: #ffb020;
        font-weight: 700;
        padding: 8px 22px;
        border-radius: 10px;
        cursor: pointer;
        font-size: 0.85rem;
        transition: all .2s;
    }

        .btn-reveal:hover {
            background: #ffb020;
            color: #070b1a;
        }

    /* ========== KAZANAN SEÇIMLER - QUİZEİ TARZI ========== */
    .winner-card {
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .winner-card:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: none;
    }
    .winner-card-header {
        display: flex;
        align-items: flex-start;
        gap: 4px;
        margin-bottom: 8px;
    }
    .winner-rank {
        color: #ffb020;
        font-weight: 900;
        font-size: 1rem;
        min-width: 22px;
    }
    .winner-card-name {
        color: #e9ecff;
        font-weight: 700;
        font-size: 0.88rem;
        line-height: 1.3;
    }
    .winner-card-thumb {
        width: 100%;
        max-width: 160px;
        aspect-ratio: 16/10;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid rgba(255,255,255,0.08);
        display: block;
        margin: 8px 0;
        background: rgba(255,255,255,0.03);
    }
    .winner-stat-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.75rem;
        color: rgba(233,236,255,0.55);
        margin-bottom: 4px;
    }
    .winner-stat-row .stat-label {
        color: rgba(233,236,255,0.5);
    }
    .winner-stat-row .stat-value {
        color: #e9ecff;
        font-weight: 800;
        font-size: 0.85rem;
    }
    .winner-progress-bar {
        width: 100%;
        height: 5px;
        background: rgba(255,255,255,0.06);
        border-radius: 999px;
        overflow: hidden;
        margin-top: 2px;
    }
    .winner-progress-bar .fill-red {
        height: 100%;
        background: linear-gradient(90deg, #ff2d55, #ff5b3a);
        border-radius: 999px;
    }
    .winner-progress-bar .fill-blue {
        height: 100%;
        background: linear-gradient(90deg, #2d7aff, #60a5fa);
        border-radius: 999px;
    }

    /* Eski winner-row ve stat-sub-panel (blind/tier için hala kullanılıyor) */
    .winner-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        font-size: 0.83rem;
    }

        .winner-row:last-child {
            border-bottom: none;
        }

    .winner-name {
        color: #e9ecff;
        font-weight: 600;
    }

    .winner-stat {
        color: rgba(233,236,255,0.5);
        font-size: 0.78rem;
    }

    .stat-sub-panel {
        margin-top: 12px;
    }

        .stat-sub-panel h6 {
            color: rgba(233,236,255,0.6);
            font-weight: 700;
            font-size: 0.8rem;
            margin-bottom: 8px;
        }

    /* ========== YORUM BOLUMU ========== */
    .comment-box {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        padding: 20px;
    }

        .comment-box h5 {
            color: #ffb020;
            font-weight: 800;
            font-size: 1rem;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .comment-form textarea {
        width: 100%;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 10px;
        color: #e9ecff;
        padding: 12px;
        font-size: 0.85rem;
        resize: vertical;
        min-height: 70px;
        margin-bottom: 10px;
    }

        .comment-form textarea:focus {
            outline: none;
            border-color: #ffb020;
        }

    .btn-comment-submit {
        background: #ffb020;
        color: #070b1a;
        font-weight: 700;
        border: none;
        padding: 8px 22px;
        border-radius: 10px;
        font-size: 0.82rem;
        cursor: pointer;
        transition: all .15s;
    }

        .btn-comment-submit:hover {
            background: #ffc040;
        }

    .login-prompt {
        text-align: center;
        padding: 20px;
        color: rgba(233,236,255,0.5);
        font-size: 0.85rem;
    }

    .btn-login-comment {
        display: inline-block;
        margin-top: 10px;
        background: rgba(255,176,32,0.12);
        border: 2px solid #ffb020;
        color: #ffb020;
        font-weight: 700;
        padding: 8px 24px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 0.85rem;
        transition: all .2s;
    }

        .btn-login-comment:hover {
            background: #ffb020;
            color: #070b1a;
            text-decoration: none;
        }

    .comment-item {
        padding: 14px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

        .comment-item:last-child {
            border-bottom: none;
        }

    .comment-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 6px;
    }

    .comment-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255,176,32,0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #ffb020;
        font-size: 0.8rem;
    }

    .comment-username {
        font-weight: 700;
        color: #ffb020;
        font-size: 0.85rem;
    }

    .comment-date {
        color: rgba(233,236,255,0.35);
        font-size: 0.72rem;
    }

    .comment-text {
        color: rgba(233,236,255,0.8);
        font-size: 0.85rem;
        line-height: 1.5;
        padding-left: 42px;
    }

    /* ========== PUAN (RATING) SISTEMI ========== */
    .rating-box {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .rating-display {
        display: flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,176,32,0.08);
        border: 1px solid rgba(255,176,32,0.2);
        border-radius: 12px;
        padding: 8px 16px;
    }

    .rating-star-icon {
        color: #ffb020;
        font-size: 1.2rem;
    }

    .rating-score {
        color: #e9ecff;
        font-weight: 800;
        font-size: 1.1rem;
    }

    .rating-max {
        color: rgba(233,236,255,0.4);
        font-weight: 600;
        font-size: 0.85rem;
    }

    .rating-dot {
        color: rgba(233,236,255,0.3);
        font-size: 0.8rem;
    }

    .rating-count {
        color: rgba(233,236,255,0.5);
        font-size: 0.82rem;
    }

    .rating-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(255,176,32,0.1);
        border: 1px solid rgba(255,176,32,0.25);
        color: #ffb020;
        font-weight: 700;
        font-size: 0.8rem;
        padding: 6px 14px;
        border-radius: 10px;
        cursor: pointer;
        transition: all .2s;
    }

        .rating-action-btn:hover {
            background: rgba(255,176,32,0.2);
            border-color: #ffb020;
        }

    .rating-picker {
        display: none;
        background: rgba(15,20,40,0.97);
        border: 1px solid rgba(255,176,32,0.3);
        border-radius: 14px;
        padding: 16px;
        margin-top: 10px;
        margin-bottom: 16px;
        animation: fadeIn 0.2s ease;
    }

        .rating-picker.show {
            display: block;
        }

    .rating-picker-title {
        color: #ffb020;
        font-weight: 700;
        font-size: 0.9rem;
        margin-bottom: 12px;
        text-align: center;
    }

    .rating-stars {
        display: flex;
        justify-content: center;
        gap: 4px;
        margin-bottom: 12px;
    }

    .star-btn {
        background: none;
        border: none;
        font-size: 1.6rem;
        cursor: pointer;
        color: rgba(233,236,255,0.2);
        transition: all .15s;
        padding: 2px 4px;
    }

        .star-btn:hover,
        .star-btn.active {
            color: #ffb020;
            transform: scale(1.15);
        }

        .star-btn.hovered {
            color: #ffc040;
        }

    .rating-selected-text {
        text-align: center;
        color: rgba(233,236,255,0.6);
        font-size: 0.8rem;
        margin-bottom: 10px;
        min-height: 20px;
    }

    .btn-submit-rating {
        display: block;
        width: 100%;
        background: #ffb020;
        color: #070b1a;
        font-weight: 700;
        border: none;
        padding: 10px;
        border-radius: 10px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all .15s;
    }

        .btn-submit-rating:hover {
            background: #ffc040;
        }

        .btn-submit-rating:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .alert-success-custom {
        background: rgba(34,197,94,0.1);
        border: 1px solid rgba(34,197,94,0.3);
        color: #22c55e;
        border-radius: 10px;
        padding: 10px 16px;
        font-size: 0.85rem;
        margin-bottom: 16px;
        font-weight: 600;
    }
</style>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert-success-custom">@TempData["Success"]</div>
}

<div class="details-page">

    <!-- UST BADGE -->
    <div class="top-badge">🏆 Turnuva</div>

    <!-- ANA GRID -->
    <div class="detail-grid">

        <!-- ========== SOL KOLON ========== -->
        <div class="left-col">
            @if (!string.IsNullOrWhiteSpace(t.CoverImageUrl))
            {
                <img src="@t.CoverImageUrl" alt="@t.Title" class="cover-img" />
            }
            else
            {
                <div class="no-cover">🎮</div>
            }

            @if (Model.ActiveItemCount >= 2)
            {
                <a href="/Play/Start?slug=@t.Slug&mode=bracket&value=8" class="btn-play-big">
                    ▶ OYNA
                </a>
            }
            else
            {
                <div class="btn-play-big" style="opacity:0.4;cursor:not-allowed;">
                    ▶ OYNA (en az 2 item gerekli)
                </div>
            }
        </div>

        <!-- ========== ORTA KOLON ========== -->
        <div class="center-col">
            <h1>@t.Title</h1>

            <!-- Mod Etiketleri -->
            <div class="mode-tags">
                <a href="/Play/Start?slug=@t.Slug&mode=bracket&value=8" class="mode-tag">Turnuva Ağacı</a>
                <a href="/Play/Start?slug=@t.Slug&mode=blind&value=5" class="mode-tag">Kör Sıralama</a>
                <a href="/Play/Start?slug=@t.Slug&mode=tier" class="mode-tag">Tier List</a>
            </div>

            <!-- Aciklama -->
            @if (!string.IsNullOrWhiteSpace(t.Description))
            {
                <div class="detail-desc">@t.Description</div>
            }

            <!-- Olusturan -->
            <div class="creator-box">
                <div class="creator-avatar">A</div>
                <div>
                    <div class="creator-label">Oluşturan</div>
                    <div class="creator-name">Anonim</div>
                </div>
            </div>

            <!-- ===== PUAN (RATING) BOLUMU ===== -->
            <div class="rating-box">
                <div class="rating-display">
                    <span class="rating-star-icon">⭐</span>
                    <span class="rating-score">@Model.AverageRating</span>
                    <span class="rating-max">/10</span>
                </div>
                <span class="rating-dot">·</span>
                <span class="rating-count">@Model.TotalRatingCount oy</span>

                @if (SignInManager.IsSignedIn(User))
                {
                    <button class="rating-action-btn" onclick="toggleRatingPicker()">
                        ⭐ @(Model.CurrentUserRating.HasValue ? "Puanını Güncelle" : "Puan Ver")
                    </button>
                }
                else
                {
                    <a href="/Identity/Account/Login" class="rating-action-btn" style="text-decoration:none;">
                        ⭐ Puan Ver
                    </a>
                }
            </div>

            <!-- Puan Secici (Giris yapan kullanicilar icin) -->
            @if (SignInManager.IsSignedIn(User))
            {
                <div class="rating-picker" id="ratingPicker">
                    <div class="rating-picker-title">Turnuvaya puan ver (1-10)</div>
                    <div class="rating-stars" id="ratingStars">
                        @for (int i = 1; i <= 10; i++)
                        {
                            var starClass = Model.CurrentUserRating.HasValue && i <= Model.CurrentUserRating.Value ? "active" : "";
                            <button type="button"
                                    class="star-btn @starClass"
                                    data-value="@i"
                                    onclick="selectRating(@i)"
                                    onmouseenter="hoverRating(@i)"
                                    onmouseleave="unhoverRating()">
                                ★
                            </button>
                        }
                    </div>
                    <div class="rating-selected-text" id="ratingText">
                        @if (Model.CurrentUserRating.HasValue)
                        {
                            <text>Mevcut puanınız: @Model.CurrentUserRating.Value/10</text>
                        }
                        else
                        {
                            <text>Bir puan seçin</text>
                        }
                    </div>
                    <form method="post" asp-controller="Tournaments" asp-action="RateTournament" id="ratingForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="tournamentId" value="@t.Id" />
                        <input type="hidden" name="score" id="ratingScoreInput" value="@(Model.CurrentUserRating ?? 0)" />
                        <button type="submit" class="btn-submit-rating" id="btnSubmitRating"
                        @(Model.CurrentUserRating.HasValue ? "" : "disabled")>
                            @(Model.CurrentUserRating.HasValue ? "Puanı Güncelle" : "Puanı Gönder")
                        </button>
                    </form>
                </div>
            }

            <!-- Meta Bilgiler -->
            <div class="meta-row">
                <div class="meta-item">
                    🔥 <span class="val">@Model.TotalPlayCount</span> oynanma
                </div>
                <div class="meta-item">
                    🎮 <span class="val">Oyun</span>
                </div>
                <div class="meta-item">
                    📋 <span class="val">@Model.TotalItemCount</span> seçim
                </div>
                <div class="meta-item">
                    💬 <span class="val">@Model.CommentCount</span> yorum
                </div>
                <div class="meta-item">
                    📅 @t.CreatedAt.ToString("dd MMM yyyy")
                </div>
                @if (t.Category != null)
                {
                    <div class="meta-item">
                        📂 <span class="val">@t.Category.Name</span>
                    </div>
                }
            </div>

            <!-- Oyun Modlari Kartlari -->
            <div class="modes-section">
                <h4>🎮 Oyun Modu Seç</h4>
                <div class="mode-cards">
                    <!-- BRACKET -->
                    <div class="mode-card-v2">
                        <h6>⚔️ Turnuva Ağacı</h6>
                        <p>Eleme usulü VS turnuvası. 2 seçenekten birini seç, şampiyonu belirle!</p>
                        @if (Model.ActiveItemCount >= 8)
                        {
                            <a href="/Play/Start?slug=@t.Slug&mode=bracket&value=8" class="btn-mode">8'li</a>
                            <a href="/Play/Start?slug=@t.Slug&mode=bracket&value=16" class="btn-mode">16'lı</a>
                        }
                        else if (Model.ActiveItemCount >= 2)
                        {
                            <a href="/Play/Start?slug=@t.Slug&mode=bracket&value=@Model.ActiveItemCount" class="btn-mode">Başla</a>
                        }
                        else
                        {
                            <span style="color:rgba(255,100,100,0.7);font-size:0.75rem;">En az 2 aktif item gerekli.</span>
                        }
                    </div>

                    <!-- BLIND -->
                    <div class="mode-card-v2">
                        <h6>🎯 Kör Sıralama</h6>
                        <p>Rastgele gelen item'ları sıralama slotlarına yerleştir. Kilitli slot!</p>
                        @if (Model.ActiveItemCount >= 5)
                        {
                            <a href="/Play/Start?slug=@t.Slug&mode=blind&value=5" class="btn-mode">Top 5</a>
                            <a href="/Play/Start?slug=@t.Slug&mode=blind&value=10" class="btn-mode">Top 10</a>
                        }
                        else if (Model.ActiveItemCount >= 2)
                        {
                            <a href="/Play/Start?slug=@t.Slug&mode=blind&value=@Model.ActiveItemCount" class="btn-mode">Başla</a>
                        }
                        else
                        {
                            <span style="color:rgba(255,100,100,0.7);font-size:0.75rem;">En az 2 aktif item gerekli.</span>
                        }
                    </div>

                    <!-- TIER -->
                    <div class="mode-card-v2">
                        <h6>🏷️ Tier List</h6>
                        <p>Tüm item'ları S/A/B/C/D tier'larına yerleştir veya pas geç!</p>
                        @if (Model.ActiveItemCount >= 2)
                        {
                            <a href="/Play/Start?slug=@t.Slug&mode=tier" class="btn-mode">Başla</a>
                        }
                        else
                        {
                            <span style="color:rgba(255,100,100,0.7);font-size:0.75rem;">En az 2 aktif item gerekli.</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ========== SAĞ KOLON ========== -->
        <div class="right-col">

            <!-- KAZANAN SECIMLER (SPOILER) - QUİZEİ TARZI RESİMLİ -->
            @if (stats != null && (stats.TotalBracketRuns > 0 || stats.TotalBlindRuns > 0 || stats.TotalTierRuns > 0))
            {
                <section>
                    <h5>🏆 Kazanan Seçimler</h5>

                    <div class="spoiler-wrapper">
                        <div class="spoiler-overlay" id="spoilerOverlay">
                            <p>Spoileri önlemek için<br />seçimler gizlenmiştir.</p>
                            <button class="btn-reveal" onclick="revealSpoiler()">👁 SEÇİMLERİ GÖSTER</button>
                        </div>

                        <div class="spoiler-content" id="spoilerContent">

                            @if (stats.BracketTopWinners.Any())
                            {
                                <div class="stat-sub-panel">
                                    <h6>⚔️ Bracket - En Çok Kazananlar (@stats.TotalBracketRuns oyun)</h6>

                                    @{ var bracketRank = 0; }
                                    @foreach (var item in stats.BracketTopWinners)
                                    {
                                        bracketRank++;
                                        var thumbUrl = GetItemThumb(item.ImageUrl, null);
                                        // item'ın YouTubeVideoId'sini bulmak için tournament items'dan çek
                                        var tItem = t.Items.FirstOrDefault(x => x.Id == item.ItemId);
                                        if (thumbUrl == null && tItem != null)
                                        {
                                            thumbUrl = GetItemThumb(tItem.ImageUrl, tItem.YouTubeVideoId);
                                        }
                                        var champPercent = stats.TotalBracketRuns == 0 ? 0 : (int)Math.Round(item.WinCount * 100.0 / stats.TotalBracketRuns);

                                        <div class="winner-card">
                                            <div class="winner-card-header">
                                                <span class="winner-rank">@bracketRank.</span>
                                                <span class="winner-card-name">@item.ItemName</span>
                                            </div>

                                            @if (thumbUrl != null)
                                            {
                                                <img src="@thumbUrl" alt="@item.ItemName" class="winner-card-thumb" />
                                            }

                                            <div class="winner-stat-row">
                                                <span class="stat-label">Şampiyonluk Oranı:</span>
                                                <span class="stat-value">% @champPercent</span>
                                            </div>
                                            <div class="winner-progress-bar">
                                                <div class="fill-red" style="width: @(champPercent)%;"></div>
                                            </div>

                                            <div class="winner-stat-row" style="margin-top:8px;">
                                                <span class="stat-label">Kazanma Oranı:</span>
                                                <span class="stat-value">% @item.WinRate</span>
                                            </div>
                                            <div class="winner-progress-bar">
                                                <div class="fill-blue" style="width: @(item.WinRate)%;"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (stats.BlindTopItems.Any())
                            {
                                <div class="stat-sub-panel">
                                    <h6>🎯 Blind - En İyi Sıra (@stats.TotalBlindRuns oyun)</h6>

                                    @{ var blindRank = 0; }
                                    @foreach (var item in stats.BlindTopItems)
                                    {
                                        blindRank++;
                                        var tItemB = t.Items.FirstOrDefault(x => x.Id == item.ItemId);
                                        var thumbUrlB = GetItemThumb(item.ImageUrl, tItemB?.YouTubeVideoId);

                                        <div class="winner-card">
                                            <div class="winner-card-header">
                                                <span class="winner-rank">@blindRank.</span>
                                                <span class="winner-card-name">@item.ItemName</span>
                                            </div>

                                            @if (thumbUrlB != null)
                                            {
                                                <img src="@thumbUrlB" alt="@item.ItemName" class="winner-card-thumb" />
                                            }

                                            <div class="winner-stat-row">
                                                <span class="stat-label">Ort. Sıra:</span>
                                                <span class="stat-value">@item.AveragePosition</span>
                                            </div>
                                            <div class="winner-stat-row">
                                                <span class="stat-label">1. Seçilme:</span>
                                                <span class="stat-value">@item.FirstPlaceCount</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (stats.TierTopItems.Any())
                            {
                                <div class="stat-sub-panel">
                                    <h6>🏷️ Tier - En Çok S (@stats.TotalTierRuns oyun)</h6>

                                    @{ var tierRank = 0; }
                                    @foreach (var item in stats.TierTopItems)
                                    {
                                        tierRank++;
                                        var tItemT = t.Items.FirstOrDefault(x => x.Id == item.ItemId);
                                        var thumbUrlT = GetItemThumb(item.ImageUrl, tItemT?.YouTubeVideoId);

                                        <div class="winner-card">
                                            <div class="winner-card-header">
                                                <span class="winner-rank">@tierRank.</span>
                                                <span class="winner-card-name">@item.ItemName</span>
                                            </div>

                                            @if (thumbUrlT != null)
                                            {
                                                <img src="@thumbUrlT" alt="@item.ItemName" class="winner-card-thumb" />
                                            }

                                            <div class="winner-stat-row">
                                                <span class="stat-label">S:@item.STierCount A:@item.ATierCount B:@item.BTierCount</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </section>
            }

            <!-- YORUMLAR -->
            <section class="comment-box" id="comments">
                <h5>💬 Yorumlar (@Model.CommentCount)</h5>

                @if (SignInManager.IsSignedIn(User))
                {
                    <form method="post" asp-controller="Tournaments" asp-action="AddComment" class="comment-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="tournamentId" value="@t.Id" />
                        <textarea name="content" placeholder="Yorumunuzu yazın..." maxlength="1000" required></textarea>
                        <button type="submit" class="btn-comment-submit">Yorum Yap</button>
                    </form>
                }
                else
                {
                    <div class="login-prompt">
                        💬 Yorum yapmak için giriş yapın.
                        <br />
                        <a href="/Identity/Account/Login" class="btn-login-comment">GİRİŞ YAP →</a>
                    </div>
                }

                @if (Model.Comments.Any())
                {
                    <div style="margin-top:16px;">
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="comment-item">
                                <div class="comment-header">
                                    <div class="comment-avatar">@comment.UserName[0].ToString().ToUpper()</div>
                                    <div>
                                        <span class="comment-username">@comment.UserName</span>
                                        <div class="comment-date">@comment.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                                    </div>
                                </div>
                                <div class="comment-text">@comment.Content</div>
                            </div>
                        }
                    </div>
                }
                else if (!Model.Comments.Any())
                {
                    <div style="text-align:center;padding:20px;color:rgba(233,236,255,0.35);font-size:0.85rem;">
                        Henüz yorum yapılmamış. İlk yorumu sen yap!
                    </div>
                }
            </section>
        </div>

    </div>
</div>

<script>
    // Spoiler
    function revealSpoiler() {
        document.getElementById('spoilerContent').classList.add('revealed');
        document.getElementById('spoilerOverlay').classList.add('hidden');
    }

    // Rating Picker Ac/Kapa
    function toggleRatingPicker() {
        var picker = document.getElementById('ratingPicker');
        if (picker) {
            picker.classList.toggle('show');
        }
    }

    // Secilen puan
    var selectedRating = @(Model.CurrentUserRating ?? 0);

    function selectRating(value) {
        selectedRating = value;
        document.getElementById('ratingScoreInput').value = value;
        document.getElementById('ratingText').textContent = 'Seçilen puan: ' + value + '/10';
        document.getElementById('btnSubmitRating').disabled = false;
        document.getElementById('btnSubmitRating').textContent = 'Puanı Gönder';

        // Yildizlari guncelle
        var stars = document.querySelectorAll('#ratingStars .star-btn');
        stars.forEach(function (star) {
            var starVal = parseInt(star.getAttribute('data-value'));
            if (starVal <= value) {
                star.classList.add('active');
            } else {
                star.classList.remove('active');
            }
        });
    }

    function hoverRating(value) {
        var stars = document.querySelectorAll('#ratingStars .star-btn');
        stars.forEach(function (star) {
            var starVal = parseInt(star.getAttribute('data-value'));
            if (starVal <= value) {
                star.classList.add('hovered');
            } else {
                star.classList.remove('hovered');
            }
        });
    }

    function unhoverRating() {
        var stars = document.querySelectorAll('#ratingStars .star-btn');
        stars.forEach(function (star) {
            star.classList.remove('hovered');
        });
    }
</script>