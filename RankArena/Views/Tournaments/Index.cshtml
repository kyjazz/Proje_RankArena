@model List<RankArena.Models.Entities.Tournament>
@{
    ViewData["Title"] = "Turnuvalar";
    var categories = ViewBag.Categories as List<RankArena.Models.Entities.Category> ?? new();
    var search = ViewBag.Search as string;
    var categoryId = ViewBag.CategoryId as int?;
    var sort = ViewBag.Sort as string;
}

<style>
    .filter-bar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 24px;
    }

        .filter-bar input, .filter-bar select {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            color: #e9ecff;
            border-radius: 10px;
            padding: 8px 14px;
        }

            .filter-bar input::placeholder {
                color: rgba(233,236,255,0.4);
            }

            .filter-bar input:focus, .filter-bar select:focus {
                background: rgba(255,255,255,0.08);
                border-color: #ffb020;
                box-shadow: none;
                color: #e9ecff;
            }

            .filter-bar select option {
                background: #0b1640;
                color: #e9ecff;
            }

    .t-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        padding: 20px;
        transition: all .25s;
        text-decoration: none;
        display: block;
        color: #e9ecff;
    }

        .t-card:hover {
            border-color: rgba(255,176,32,0.4);
            transform: translateY(-2px);
            color: #e9ecff;
        }

        .t-card h5 {
            font-weight: 700;
            margin-bottom: 6px;
            color: #ffb020;
        }

        .t-card .desc {
            color: rgba(233,236,255,0.6);
            font-size: 0.85rem;
        }

        .t-card .meta {
            color: rgba(233,236,255,0.45);
            font-size: 0.78rem;
            margin-top: 10px;
        }

        .t-card img {
            width: 100%;
            height: 140px;
            object-fit: cover;
            border-radius: 10px;
            margin-bottom: 12px;
        }

        .t-card .no-img {
            width: 100%;
            height: 140px;
            border-radius: 10px;
            margin-bottom: 12px;
            background: linear-gradient(135deg,#1a0a3e,#0b1640);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
        }
</style>

<h2 class="fw-bold mb-3" style="color:#e9ecff;">🏆 Turnuvalar</h2>

<form method="get" class="filter-bar">
    <input type="text" name="search" value="@search" placeholder="🔍 Ara..." />
    <select name="categoryId">
        <option value="">Tüm Kategoriler</option>
        @foreach (var c in categories)
        {
            <option value="@c.Id" selected="@(categoryId == c.Id)">@c.Name</option>
        }
    </select>
    <select name="sort">
        <option value="newest" selected="@(sort == "newest" || sort == null)">En Yeni</option>
        <option value="oldest" selected="@(sort == "oldest")">En Eski</option>
        <option value="title" selected="@(sort == "title")">A-Z</option>
    </select>
    <button type="submit" class="btn btn-sm btn-warning">Filtrele</button>
</form>

<div class="row g-3">
    @foreach (var t in Model)
    {
        <div class="col-md-3 col-sm-6">
            <a href="/t/@t.Slug" class="t-card">
                @if (!string.IsNullOrWhiteSpace(t.CoverImageUrl))
                {
                    <img src="@t.CoverImageUrl" alt="@t.Title" />
                }
                else
                {
                    <div class="no-img">🎮</div>
                }
                <h5>@t.Title</h5>
                <div class="desc">@(t.Description?.Length > 80 ? t.Description[..80] + "..." : t.Description)</div>
                <div class="meta">
                    @t.CreatedAt.ToString("dd MMM yyyy")
                    @if (t.Category != null)
                    {
                        <span>· @t.Category.Name</span>
                    }
                </div>
            </a>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <p style="color:rgba(233,236,255,0.5);">Sonuç bulunamadı.</p>
        </div>
    }
</div>