﻿@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<IdentityUser> UserManager
@inject RankArena.Data.AppDbContext DbContext

@{
    int unreadMessageCount = 0;
    if (User?.Identity?.IsAuthenticated == true)
    {
        var currentUserId = UserManager.GetUserId(User);
        if (!string.IsNullOrEmpty(currentUserId))
        {
            unreadMessageCount = await DbContext.AdminMessages
                .CountAsync(m => m.ReceiverUserId == currentUserId && !m.IsRead);
        }
    }
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RankArena</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RankArena.styles.css" asp-append-version="true" />
    <style>
        :root {
            --bg1: #0a0e27;
            --bg2: #111640;
            --bg3: #161b4a;
            --text: #e9ecff;
            --muted: rgba(233,236,255,.55);
            --accent: #ffb020;
            --accent2: #ff6b35;
            --card-bg: rgba(255,255,255,0.04);
            --card-border: rgba(255,255,255,0.08);
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: var(--bg1);
            color: var(--text);
            min-height: 100vh;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Oxygen, Ubuntu, sans-serif;
            margin: 0;
        }

        a {
            color: var(--accent);
            text-decoration: none;
        }

            a:hover {
                color: #ffc040;
                text-decoration: none;
            }

        /* ========== NAVBAR ========== */
        .topnav {
            background: linear-gradient(90deg, #0d1235 0%, #151a50 100%);
            border-bottom: 2px solid var(--accent);
            position: sticky;
            top: 0;
            z-index: 1000;
            padding: 0;
        }

            .topnav .container {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 16px;
                height: 56px;
                max-width: 1400px;
                margin: 0 auto;
            }

        .brand {
            color: var(--accent);
            font-weight: 900;
            font-size: 1.5rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            letter-spacing: -0.5px;
        }

            .brand:hover {
                color: #ffc040;
                text-decoration: none;
            }

        .brand-icon {
            font-size: 1.6rem;
        }

        .nav-center {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .nav-item-link {
            color: var(--muted);
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 0.82rem;
            font-weight: 700;
            transition: all .15s ease;
            white-space: nowrap;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
        }

            .nav-item-link .nav-icon {
                font-size: 1.1rem;
            }

            .nav-item-link:hover {
                color: var(--text);
                background: rgba(255,255,255,0.06);
            }

            .nav-item-link.active-link {
                color: var(--accent);
                background: rgba(255,176,32,0.1);
            }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-create {
            background: var(--accent);
            color: #070b1a;
            font-weight: 800;
            border: none;
            padding: 8px 20px;
            border-radius: 10px;
            font-size: 0.85rem;
            text-decoration: none;
            transition: all .15s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .btn-create:hover {
                background: #ffc040;
                color: #070b1a;
                text-decoration: none;
            }

        .btn-login {
            background: rgba(255,255,255,0.08);
            color: var(--text);
            font-weight: 700;
            border: 1px solid rgba(255,255,255,0.15);
            padding: 8px 20px;
            border-radius: 10px;
            font-size: 0.85rem;
            text-decoration: none;
            transition: all .15s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .btn-login:hover {
                background: rgba(255,255,255,0.12);
                color: var(--text);
                text-decoration: none;
            }

        .btn-nav-icon {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            color: var(--muted);
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all .15s;
        }

            .btn-nav-icon:hover {
                background: rgba(255,255,255,0.1);
                color: var(--text);
            }

        .btn-logout {
            background: transparent;
            border: 1px solid rgba(255,255,255,0.15);
            color: var(--muted);
            padding: 6px 14px;
            border-radius: 10px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all .15s ease;
        }

            .btn-logout:hover {
                border-color: rgba(255,255,255,0.30);
                color: var(--text);
                background: rgba(255,255,255,0.04);
            }

        .user-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            font-size: 0.8rem;
            color: rgba(233,236,255,0.85);
            white-space: nowrap;
            font-weight: 600;
        }

        /* ✅ Mesaj bildirim badge */
        .msg-badge {
            background: #ff4444;
            color: #fff;
            font-size: 0.65rem;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 999px;
            margin-left: 4px;
            min-width: 18px;
            text-align: center;
            display: inline-block;
            line-height: 1.3;
        }

        /* ========== FOOTER ========== */
        .site-footer {
            border-top: 1px solid rgba(255,255,255,0.06);
            padding: 24px 0;
            margin-top: 40px;
            text-align: center;
            color: rgba(233,236,255,0.35);
            font-size: 0.8rem;
            background: rgba(0,0,0,0.2);
        }

            .site-footer a {
                color: rgba(233,236,255,0.5);
            }

                .site-footer a:hover {
                    color: var(--accent);
                }

        /* ========== GENEL ========== */
        .form-control, .form-select {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            color: var(--text);
            border-radius: 10px;
        }

            .form-control:focus, .form-select:focus {
                background: rgba(255,255,255,0.08);
                border-color: var(--accent);
                box-shadow: 0 0 0 3px rgba(255,176,32,0.10);
                color: var(--text);
            }

            .form-control::placeholder {
                color: rgba(233,236,255,0.4);
            }

            .form-select option {
                background: #0b1640;
                color: var(--text);
            }

        .btn-warning {
            background: var(--accent);
            color: #070b1a;
            font-weight: 700;
            border: none;
        }

            .btn-warning:hover {
                background: #ffc040;
                color: #070b1a;
            }

        .alert-success {
            background: rgba(34,197,94,0.12);
            border-color: rgba(34,197,94,0.25);
            color: #86efac;
        }

        .alert-danger {
            background: rgba(255,45,85,0.12);
            border-color: rgba(255,45,85,0.25);
            color: #fca5a5;
        }

        .table {
            color: var(--text);
        }

            .table thead th {
                border-bottom-color: rgba(255,255,255,0.08);
                color: var(--muted);
                font-weight: 700;
                font-size: 0.82rem;
            }

            .table td {
                border-bottom-color: rgba(255,255,255,0.05);
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .nav-center {
                display: none;
            }

            .topnav .container {
                height: auto;
                padding: 10px 16px;
                flex-wrap: wrap;
                gap: 8px;
            }
        }
    </style>
</head>
<body>

    <!-- ========== NAVBAR ========== -->
    <nav class="topnav">
        <div class="container">
            <a class="brand" href="/">
                <span class="brand-icon">🏆</span> RankArena
            </a>

            <div class="nav-center">
                <a class="nav-item-link" href="/">
                    <span class="nav-icon">🏠</span>
                    ANA SAYFA
                </a>
                <a class="nav-item-link" href="/Tournaments">
                    <span class="nav-icon">⚔️</span>
                    TURNUVALAR
                </a>
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-item-link" href="/MyTournaments">
                        <span class="nav-icon">📋</span>
                        TURNUVALARIM
                    </a>

                    <!-- ✅ MESAJLARIM LİNKİ -->
                    <a class="nav-item-link" href="/MyMessages" style="position:relative;">
                        <span class="nav-icon">📬</span>
                        MESAJLARIM
                        @if (unreadMessageCount > 0)
                        {
                            <span class="msg-badge">@unreadMessageCount</span>
                        }
                    </a>
                }
                @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                {
                    <a class="nav-item-link" href="/Admin/Tournaments/Pending">
                        <span class="nav-icon">⚙️</span>
                        ADMİN
                    </a>
                    <a class="nav-item-link" href="/Admin/Categories">
                        <span class="nav-icon">📂</span>
                        KATEGORİLER
                    </a>
                }
            </div>

            <div class="nav-right">
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <a class="btn-create" href="/MyTournaments/Create">
                        <span>+</span> OLUŞTUR
                    </a>

                    <!-- ✅ Mobil mesaj ikonu -->
                    <a class="btn-nav-icon" href="/MyMessages" title="Mesajlarım" style="position:relative;">
                        📬
                        @if (unreadMessageCount > 0)
                        {
                            <span style="position:absolute; top:-4px; right:-4px; background:#ff4444; color:#fff; font-size:0.6rem; font-weight:800; padding:1px 5px; border-radius:999px; min-width:16px; text-align:center;">
                                @unreadMessageCount
                            </span>
                        }
                    </a>

                    <span class="user-badge">👤 @User.Identity.Name</span>

                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" style="display:inline;margin:0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-logout">Çıkış</button>
                    </form>
                }
                else
                {
                    <a class="btn-create" href="/MyTournaments/Create">
                        <span>+</span> OLUŞTUR
                    </a>
                    <a class="btn-login" href="/Identity/Account/Login">
                        <span>🔑</span> GİRİŞ YAP
                    </a>
                }
                <a class="btn-nav-icon" href="/Tournaments" title="Ara">🔍</a>
            </div>
        </div>
    </nav>

    <!-- ========== İÇERİK ========== -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ========== FOOTER ========== -->
    <footer class="site-footer">
        <div class="container">
            &copy; 2026 — <strong>RankArena</strong> · Tercih Turnuvası &amp; Sıralama Platformu
            · <a asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>