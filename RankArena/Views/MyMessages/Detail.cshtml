@model RankArena.Models.Entities.AdminMessage
@{
    ViewData["Title"] = Model.Subject;
}

<div class="container py-4" style="max-width:750px;">

    <a href="/MyMessages" style="color:rgba(233,236,255,0.6); text-decoration:none; font-size:0.9rem; display:inline-flex; align-items:center; gap:6px; margin-bottom:16px;">
        ← Mesajlarıma Dön
    </a>

    <div style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:18px; padding:32px; box-shadow:0 10px 30px rgba(0,0,0,0.2);">

        <!-- Başlık -->
        <div class="d-flex align-items-start justify-content-between mb-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    @switch (Model.MessageType)
                    {
                        case RankArena.Models.Entities.AdminMessageType.TurnuvaReddedildi:
                            <span style="background:rgba(255,60,60,0.15); color:#ff6b6b; padding:4px 12px; border-radius:8px; font-size:0.8rem; font-weight:700;">🚫 Turnuva Reddedildi</span>
                            break;
                        case RankArena.Models.Entities.AdminMessageType.TurnuvaYayindanKaldirildi:
                            <span style="background:rgba(255,176,32,0.15); color:#ffc040; padding:4px 12px; border-radius:8px; font-size:0.8rem; font-weight:700;">⚠️ Yayından Kaldırıldı</span>
                            break;
                        case RankArena.Models.Entities.AdminMessageType.TurnuvaSilindi:
                            <span style="background:rgba(255,255,255,0.1); color:rgba(233,236,255,0.7); padding:4px 12px; border-radius:8px; font-size:0.8rem; font-weight:700;">🗑️ Silindi</span>
                            break;
                        case RankArena.Models.Entities.AdminMessageType.GenelBilgilendirme:
                            <span style="background:rgba(56,189,248,0.15); color:#7dd3fc; padding:4px 12px; border-radius:8px; font-size:0.8rem; font-weight:700;">ℹ️ Bilgilendirme</span>
                            break;
                    }
                </div>
                <h3 style="font-weight:800; margin:0;">@Model.Subject</h3>
            </div>
            <div style="text-align:right;">
                <div style="color:rgba(233,236,255,0.5); font-size:0.85rem;">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                @if (Model.IsRead && Model.ReadAt.HasValue)
                {
                    <div style="color:rgba(34,197,94,0.7); font-size:0.75rem; margin-top:4px;">✅ Okundu: @Model.ReadAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                }
            </div>
        </div>

        <!-- Turnuva bilgisi -->
        @if (Model.Tournament != null)
        {
            <div style="background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); border-radius:10px; padding:12px 16px; margin-bottom:20px;">
                <span style="color:rgba(233,236,255,0.5); font-size:0.8rem;">İlgili Turnuva:</span>
                <span style="font-weight:700; margin-left:8px;">🏆 @Model.Tournament.Title</span>
            </div>
        }

        <!-- Gönderen -->
        <div style="margin-bottom:20px;">
            <span style="background:rgba(255,60,60,0.1); border:1px solid rgba(255,60,60,0.2); padding:4px 12px; border-radius:8px; font-size:0.8rem; color:#fca5a5; font-weight:600;">
                👑 Admin tarafından gönderildi
            </span>
        </div>

        <!-- Mesaj İçeriği -->
        <div style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.06); border-radius:12px; padding:20px; line-height:1.7; color:rgba(233,236,255,0.85); font-size:0.95rem; white-space:pre-wrap;">@Model.Content</div>
    </div>
</div>