﻿@using RankArena.Models.Entities
@{
    ViewData["Title"] = "Mesaj Gönder";
    var tournament = ViewBag.Tournament as Tournament;
    var receiverUserName = ViewBag.ReceiverUserName as string;
    var receiverUserId = ViewBag.ReceiverUserId as string;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-1 fw-bold">📩 Kullanıcıya Mesaj Gönder</h2>
        <div class="muted">Turnuva sahibine bilgilendirme mesajı gönderin.</div>
    </div>
    <a class="btn btn-ghost btn-sm px-3" asp-area="Admin" asp-controller="Messages" asp-action="Index">
        ← Gönderilen Mesajlar
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger glass">@TempData["Error"]</div>
}

<div class="glass p-4" style="max-width:700px;">
    <form method="post" asp-area="Admin" asp-controller="Messages" asp-action="Send">
        @Html.AntiForgeryToken()

        @if (tournament != null)
        {
            <input type="hidden" name="tournamentId" value="@tournament.Id" />
            <input type="hidden" name="receiverUserId" value="@receiverUserId" />

            <div class="mb-3">
                <label class="form-label fw-bold">Turnuva</label>
                <div class="form-control" style="background:rgba(255,255,255,0.03);">
                    🏆 @tournament.Title
                    <span class="muted ms-2" style="font-size:0.85rem;">(@tournament.Slug)</span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Alıcı</label>
                <div class="form-control" style="background:rgba(255,255,255,0.03);">
                    👤 @receiverUserName
                </div>
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label fw-bold">Alıcı Kullanıcı ID</label>
                <input type="text" name="receiverUserId" class="form-control" placeholder="Kullanıcı ID girin..." required />
            </div>
        }

        <div class="mb-3">
            <label class="form-label fw-bold">Mesaj Türü</label>
            <select name="messageType" class="form-select" required>
                <option value="1">🚫 Turnuva Reddedildi</option>
                <option value="2">⚠️ Turnuva Yayından Kaldırıldı</option>
                <option value="3">🗑️ Turnuva Silindi</option>
                <option value="4">ℹ️ Genel Bilgilendirme</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mesaj Başlığı</label>
            <input type="text" name="subject" class="form-control" maxlength="200"
                   placeholder="Örn: Turnuvanız reddedildi" required />
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mesaj İçeriği</label>
            <textarea name="content" class="form-control" rows="5" maxlength="2000"
                      placeholder="Kullanıcıya iletmek istediğiniz açıklamayı buraya yazın..." required></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-accent px-4">
                📨 Mesajı Gönder
            </button>
            <a class="btn btn-ghost px-4" asp-area="Admin" asp-controller="Tournaments" asp-action="All">
                İptal
            </a>
        </div>
    </form>
</div>