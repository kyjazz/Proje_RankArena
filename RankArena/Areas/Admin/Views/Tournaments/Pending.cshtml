@model List<RankArena.Models.Entities.Tournament>
@{
    ViewData["Title"] = "Onay Bekleyen Turnuvalar";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-1 fw-bold">Onay Bekleyen Turnuvalar</h2>
        <div class="muted">Admin panelinden yayın akışını yönet.</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-info btn-sm px-3"
           asp-area="Admin" asp-controller="Tournaments" asp-action="All">
            📋 Tüm Turnuvalar
        </a>
        <span class="badge badge-soft px-3 py-2">Toplam: @Model.Count</span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success glass">@TempData["Success"]</div>
}
@if (TempData["Info"] != null)
{
    <div class="alert alert-info glass">@TempData["Info"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger glass">@TempData["Error"]</div>
}

<div class="glass p-3">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="fs-4 fw-semibold">Şu an onay bekleyen turnuva yok ✅</div>
            <div class="muted mt-2">Yeni turnuva oluşturulunca burada görünecek.</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-darkish table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:40%;">Başlık</th>
                        <th>Slug</th>
                        <th style="width:320px;">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@t.Title</div>
                                <div class="muted" style="font-size:12px;">
                                    Oluşturma: @t.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </div>
                            </td>

                            <td>
                                <span class="badge bg-dark border">@t.Slug</span>
                            </td>

                            <td class="d-flex gap-2">
                                <form method="post"
                                      asp-area="Admin"
                                      asp-controller="Tournaments"
                                      asp-action="Publish"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="btn btn-accent btn-sm px-3">Yayınla</button>
                                </form>

                                <a class="btn btn-ghost btn-sm px-3" target="_blank"
                                   asp-area="Admin" asp-controller="Tournaments" asp-action="Preview" asp-route-id="@t.Id">
                                    Önizle
                                </a>

                                <button type="button" class="btn btn-outline-danger btn-sm px-3"
                                        onclick="showAdminDeleteModal(@t.Id, '@t.Title.Replace("'", "\\'")')">
                                    🗑️ Sil
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ADMİN SİLME ONAY MODALI -->
<div id="adminDeleteModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.6); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:#0f1428; border:1px solid rgba(255,100,100,0.3); border-radius:16px; padding:28px; max-width:420px; width:90%; text-align:center;">
        <h5 style="color:#e9ecff; font-weight:800; margin-bottom:10px;">🗑️ Turnuvayı Sil (Admin)</h5>
        <p style="color:rgba(233,236,255,0.7); font-size:0.9rem; margin-bottom:20px;">
            <strong id="adminDeleteName" style="color:#ff4444;"></strong> turnuvasını kalıcı olarak silmek istediğinize emin misiniz?
            <br /><small style="color:rgba(233,236,255,0.5);">Tüm item'lar, oynanma verileri, yorumlar ve puanlar silinecektir.</small>
        </p>
        <div style="display:flex; gap:12px; justify-content:center;">
            <form id="adminDeleteForm" method="post"
                  asp-area="Admin" asp-controller="Tournaments" asp-action="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="adminDeleteId" />
                <button type="submit" style="background:#ff4444; color:#fff; font-weight:700; border:none; padding:10px 28px; border-radius:10px; font-size:0.9rem; cursor:pointer;">
                    Evet, Sil
                </button>
            </form>
            <button type="button" onclick="hideAdminDeleteModal()"
                    style="background:none; border:1px solid rgba(255,255,255,0.2); color:rgba(233,236,255,0.7); font-weight:600; padding:10px 28px; border-radius:10px; font-size:0.9rem; cursor:pointer;">
                İptal
            </button>
        </div>
    </div>
</div>

<script>
    function showAdminDeleteModal(id, title) {
        document.getElementById('adminDeleteId').value = id;
        document.getElementById('adminDeleteName').textContent = title;
        document.getElementById('adminDeleteModal').style.display = 'flex';
    }
    function hideAdminDeleteModal() {
        document.getElementById('adminDeleteModal').style.display = 'none';
    }
    document.getElementById('adminDeleteModal').addEventListener('click', function (e) {
        if (e.target === this) hideAdminDeleteModal();
    });
</script>