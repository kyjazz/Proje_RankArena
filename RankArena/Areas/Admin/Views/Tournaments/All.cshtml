@model List<RankArena.Models.Entities.Tournament>
@{
    ViewData["Title"] = "Tüm Turnuvalar (Admin)";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-1 fw-bold">Tüm Turnuvalar</h2>
        <div class="muted">Admin olarak tüm turnuvaları yönet.</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-warning btn-sm px-3"
           asp-area="Admin" asp-controller="Tournaments" asp-action="Pending">
            ⏳ Onay Bekleyenler
        </a>
        <a class="btn btn-outline-info btn-sm px-3"
           asp-area="Admin" asp-controller="Messages" asp-action="Index">
            📩 Gönderilen Mesajlar
        </a>
        <span class="badge badge-soft px-3 py-2">Toplam: @Model.Count</span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success glass">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger glass">@TempData["Error"]</div>
}

<div class="glass p-3">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="fs-4 fw-semibold">Henüz hiç turnuva yok.</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-darkish table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:30%;">Başlık</th>
                        <th>Durum</th>
                        <th>Kategori</th>
                        <th>Oluşturma</th>
                        <th style="width:340px;">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@t.Title</div>
                                <div class="muted" style="font-size:11px;">@t.Slug</div>
                            </td>

                            <td>
                                @if (t.IsPublished)
                                {
                                    <span class="badge bg-success">Yayınlı</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Onay Bekliyor</span>
                                }
                            </td>

                            <td>
                                @if (t.Category != null)
                                {
                                    <span class="badge bg-dark border">@t.Category.Name</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>

                            <td>
                                <small class="muted">@t.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                            </td>

                            <td class="d-flex gap-2 flex-wrap">
                                @if (t.IsPublished)
                                {
                                    <form method="post"
                                          asp-area="Admin"
                                          asp-controller="Tournaments"
                                          asp-action="Unpublish"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="btn btn-outline-warning btn-sm px-3">Yayından Kaldır</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post"
                                          asp-area="Admin"
                                          asp-controller="Tournaments"
                                          asp-action="Publish"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="btn btn-accent btn-sm px-3">Yayınla</button>
                                    </form>
                                }

                                <a class="btn btn-ghost btn-sm px-3" target="_blank"
                                   asp-area="Admin" asp-controller="Tournaments" asp-action="Preview" asp-route-id="@t.Id">
                                    Önizle
                                </a>

                                <!-- ✅ MESAJ GÖNDER BUTONU -->
                                <button type="button" class="btn btn-outline-info btn-sm px-3"
                                        onclick="showMessageModal(@t.Id, '@t.Title.Replace("'", "\\'")' )">
                                    📩 Mesaj
                                </button>

                                <button type="button" class="btn btn-outline-danger btn-sm px-3"
                                        onclick="showDeleteModal(@t.Id, '@t.Title.Replace("'", "\\'")' )">
                                    🗑️ Sil
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ===================== MESAJ GÖNDER MODALI ===================== -->
<div id="messageModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.65); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:#0f1428; border:1px solid rgba(56,189,248,0.3); border-radius:18px; padding:28px; max-width:520px; width:92%;">
        <h5 style="color:#e9ecff; font-weight:800; margin-bottom:4px;">📩 Kullanıcıya Mesaj Gönder</h5>
        <p style="color:rgba(233,236,255,0.5); font-size:0.85rem; margin-bottom:18px;">
            <strong id="msgTournamentName" style="color:#ffb020;"></strong> turnuvasının sahibine mesaj gönderin.
        </p>

        <form id="messageForm" method="post" asp-area="Admin" asp-controller="Messages" asp-action="SendQuick">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tournamentId" id="msgTournamentId" />
            <input type="hidden" name="returnUrl" value="/Admin/Tournaments/All" />

            <div style="margin-bottom:14px;">
                <label style="font-weight:700; font-size:0.85rem; color:rgba(233,236,255,0.85); margin-bottom:6px; display:block;">Mesaj Türü</label>
                <select name="messageType" class="form-select" style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:#e9ecff; border-radius:10px;">
                    <option value="1">🚫 Turnuva Reddedildi</option>
                    <option value="2">⚠️ Turnuva Yayından Kaldırıldı</option>
                    <option value="3">🗑️ Turnuva Silindi</option>
                    <option value="4">ℹ️ Genel Bilgilendirme</option>
                </select>
            </div>

            <div style="margin-bottom:14px;">
                <label style="font-weight:700; font-size:0.85rem; color:rgba(233,236,255,0.85); margin-bottom:6px; display:block;">Mesaj İçeriği</label>
                <textarea name="content" rows="5" class="form-control" maxlength="2000" required
                          style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); color:#e9ecff; border-radius:10px;"
                          placeholder="Turnuvanın neden reddedildiğini / kaldırıldığını / silindiğini açıklayın..."></textarea>
            </div>

            <div style="display:flex; gap:12px; justify-content:flex-end;">
                <button type="button" onclick="hideMessageModal()"
                        style="background:none; border:1px solid rgba(255,255,255,0.2); color:rgba(233,236,255,0.7); font-weight:600; padding:10px 24px; border-radius:10px; font-size:0.9rem; cursor:pointer;">
                    İptal
                </button>
                <button type="submit"
                        style="background:linear-gradient(90deg,#ffb020,#ff5b3a); color:#0b1024; font-weight:700; border:none; padding:10px 28px; border-radius:10px; font-size:0.9rem; cursor:pointer;">
                    📨 Gönder
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ===================== SİLME ONAY MODALI ===================== -->
<div id="deleteModal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.6); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:#0f1428; border:1px solid rgba(255,100,100,0.3); border-radius:16px; padding:28px; max-width:420px; width:90%; text-align:center;">
        <h5 style="color:#e9ecff; font-weight:800; margin-bottom:10px;">🗑️ Turnuvayı Sil</h5>
        <p style="color:rgba(233,236,255,0.7); font-size:0.9rem; margin-bottom:20px;">
            <strong id="deleteTournamentName" style="color:#ff4444;"></strong> turnuvasını silmek istediğinize emin misiniz?
            <br /><small style="color:rgba(233,236,255,0.5);">Bu işlem geri alınamaz.</small>
        </p>
        <div style="display:flex; gap:12px; justify-content:center;">
            <form id="deleteForm" method="post" asp-area="Admin" asp-controller="Tournaments" asp-action="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />
                <button type="submit" style="background:#ff4444; color:#fff; font-weight:700; border:none; padding:10px 28px; border-radius:10px; font-size:0.9rem; cursor:pointer;">
                    Evet, Sil
                </button>
            </form>
            <button type="button" onclick="hideDeleteModal()"
                    style="background:none; border:1px solid rgba(255,255,255,0.2); color:rgba(233,236,255,0.7); font-weight:600; padding:10px 28px; border-radius:10px; font-size:0.9rem; cursor:pointer;">
                İptal
            </button>
        </div>
    </div>
</div>

<script>
    // ===== MESAJ MODAL =====
    function showMessageModal(id, title) {
        document.getElementById('msgTournamentId').value = id;
        document.getElementById('msgTournamentName').textContent = title;
        document.getElementById('messageModal').style.display = 'flex';
    }
    function hideMessageModal() {
        document.getElementById('messageModal').style.display = 'none';
    }
    document.getElementById('messageModal').addEventListener('click', function (e) {
        if (e.target === this) hideMessageModal();
    });

    // ===== SİLME MODAL =====
    function showDeleteModal(id, title) {
        document.getElementById('deleteId').value = id;
        document.getElementById('deleteTournamentName').textContent = title;
        document.getElementById('deleteModal').style.display = 'flex';
    }
    function hideDeleteModal() {
        document.getElementById('deleteModal').style.display = 'none';
    }
    document.getElementById('deleteModal').addEventListener('click', function (e) {
        if (e.target === this) hideDeleteModal();
    });
</script>