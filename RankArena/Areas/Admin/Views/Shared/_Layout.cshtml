<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RankArena Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        :root {
            --bg1: #070b1a;
            --bg2: #0b1640;
            --card: rgba(255,255,255,.06);
            --border: rgba(255,255,255,.10);
            --text: #e9ecff;
            --muted: rgba(233,236,255,.65);
            --accent: #ffb020;
            --accent2: #ff5b3a;
        }

        body {
            min-height: 100vh;
            background: radial-gradient(900px 500px at 15% 10%, rgba(255,176,32,.15), transparent 60%), radial-gradient(800px 450px at 85% 20%, rgba(255,91,58,.16), transparent 60%), linear-gradient(180deg, var(--bg2), var(--bg1));
            color: var(--text);
        }

        .glass {
            background: var(--card);
            border: 1px solid var(--border);
            box-shadow: 0 10px 30px rgba(0,0,0,.25);
            backdrop-filter: blur(10px);
            border-radius: 16px;
        }

        .topbar {
            background: rgba(10,16,40,.55);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(10px);
        }

        .brand {
            font-weight: 800;
            letter-spacing: .3px;
        }

        .navbtn {
            border: 1px solid var(--border);
            background: rgba(255,255,255,.04);
            color: var(--text);
        }

            .navbtn:hover {
                border-color: rgba(255,176,32,.55);
                background: rgba(255,176,32,.10);
                color: var(--text);
            }

        .badge-soft {
            border: 1px solid rgba(255,176,32,.35);
            background: rgba(255,176,32,.12);
            color: #ffd37a;
        }

        .btn-accent {
            border: 0;
            background: linear-gradient(90deg, var(--accent), var(--accent2));
            color: #0b1024;
            font-weight: 700;
        }

            .btn-accent:hover {
                filter: brightness(1.05);
            }

        .btn-ghost {
            border: 1px solid var(--border);
            background: rgba(255,255,255,.04);
            color: var(--text);
        }

            .btn-ghost:hover {
                border-color: rgba(255,255,255,.20);
                background: rgba(255,255,255,.06);
                color: var(--text);
            }

        /* tabloyu gerçekten dark yap */
        .table-darkish {
            --bs-table-bg: transparent;
            --bs-table-color: var(--text);
            --bs-table-border-color: rgba(255,255,255,.10);
            --bs-table-striped-bg: rgba(255,255,255,.04);
            --bs-table-hover-bg: rgba(255,255,255,.06);
        }

            .table-darkish thead th {
                color: rgba(233,236,255,.85);
                border-bottom: 1px solid rgba(255,255,255,.14);
            }

        .muted {
            color: var(--muted);
        }
    </style>
</head>
<body>

    <nav class="navbar topbar navbar-expand-lg navbar-dark">
        <div class="container py-2">
            <a class="navbar-brand brand" href="/">RankArena <span class="muted">Admin</span></a>

            <div class="ms-auto d-flex gap-2">
                <a class="btn btn-sm navbtn" href="/Admin/Tournaments/Pending">Onay Bekleyenler</a>
                <a class="btn btn-sm navbtn" href="/MyTournaments">Benim Turnuvalarım</a>
            </div>
        </div>
    </nav>

    <div class="container py-4">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
