@page
@model RankArena.Areas.Identity.Pages.Account.ConfirmEmailModel
@{
    ViewData["Title"] = "E-posta Doğrulama";
}

<style>
    .confirm-wrapper {
        min-height: calc(100vh - 160px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px 0;
    }

    .confirm-card {
        width: 100%;
        max-width: 520px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
        padding: 40px 28px;
        text-align: center;
    }

    .confirm-icon {
        font-size: 4rem;
        margin-bottom: 16px;
    }

    .confirm-title {
        font-weight: 900;
        margin-bottom: 10px;
    }

    .confirm-text {
        color: rgba(233,236,255,.75);
        margin-bottom: 24px;
        line-height: 1.6;
    }

    .btn-go {
        background: #ffb020;
        color: #070b1a;
        font-weight: 800;
        border: none;
        border-radius: 10px;
        padding: 10px 28px;
        text-decoration: none;
    }

        .btn-go:hover {
            background: #ffc040;
            color: #070b1a;
        }
</style>

<div class="confirm-wrapper">
    <div class="confirm-card">
        @if (Model.StatusMessage == null)
        {
            <div class="confirm-icon">❌</div>
            <h2 class="confirm-title" style="color:#ff4444;">Doğrulama Başarısız</h2>
            <p class="confirm-text">E-posta doğrulama bağlantısı geçersiz veya süresi dolmuş.</p>
        }
        else
        {
            <div class="confirm-icon">✅</div>
            <h2 class="confirm-title" style="color:#4CAF50;">E-posta Doğrulandı!</h2>
            <p class="confirm-text">
                Hesabınız başarıyla doğrulandı.<br />
                Artık giriş yapabilirsiniz.
            </p>
            <a asp-page="./Login" class="btn-go">Giriş Yap</a>
        }
    </div>
</div>