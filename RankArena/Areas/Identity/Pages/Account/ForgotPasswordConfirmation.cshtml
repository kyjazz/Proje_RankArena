@page
@{
    ViewData["Title"] = "Şifre Sıfırlama Gönderildi";
}

<style>
    .fpconfirm-wrapper {
        min-height: calc(100vh - 160px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px 0;
    }

    .fpconfirm-card {
        width: 100%;
        max-width: 520px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
        padding: 40px 28px;
        text-align: center;
    }

    .fpconfirm-icon {
        font-size: 4rem;
        margin-bottom: 16px;
    }

    .fpconfirm-title {
        color: #ffb020;
        font-weight: 900;
        margin-bottom: 10px;
    }

    .fpconfirm-text {
        color: rgba(233,236,255,.75);
        margin-bottom: 24px;
        line-height: 1.7;
    }
</style>

<div class="fpconfirm-wrapper">
    <div class="fpconfirm-card">
        <div class="fpconfirm-icon">📧</div>
        <h2 class="fpconfirm-title">E-posta Gönderildi</h2>
        <p class="fpconfirm-text">
            Eğer bu e-posta adresiyle kayıtlı bir hesap varsa,<br />
            şifre sıfırlama bağlantısı gönderilmiştir.<br /><br />
            Lütfen e-postanızı kontrol edin.<br />
            Gelmezse spam/gereksiz klasörüne de bakın.
        </p>
    </div>
</div>